            TextSize = 15,
            Align = Enum.TextXAlignment.Center,
            Truncate = true,
            Z = Library.Order.Window + 6
        })

        local Pulse = MakeFrame({
            Parent = Field.Instance,
            Size = UDim2.fromScale(1, 1),
            Transparency = 1,
            Round = 3,
            Z = Library.Order.Window + 6
        })

        Pulse.Instance.BackgroundColor3 = Library.Theme.Accent
        Pulse:AddToTheme({
            BackgroundColor3 = "Accent"
        })

        Library:StampResting(Pulse.Instance, "BackgroundTransparency", 1)

        local Hit = MakeButton({
            Parent = Element.Row.Instance,
            Pos = UDim2.fromOffset(10, 4),
            Size = UDim2.fromOffset(Inner, 24),
            Z = Library.Order.Window + 7
        })

        Hit:HoverGradient(Field)

        Hit:Connect("MouseButton1Down", function()
            Library:Tween({
                BackgroundTransparency = 0.25
            }, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), Pulse.Instance)

            task.delay(0.1, function()
                Library:Tween({
                    BackgroundTransparency = 1
                }, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), Pulse.Instance)
            end)

            Library:SafeCall(Handler)
        end)
    end

    Action(Params.RefreshText or "Refresh List", function()
        Refresh()
    end)

    local Box = Section:NewRow(56, "Shared Config", "Textbox")

    MakeText({
        Parent = Box.Row.Instance,
        Pos = UDim2.fromOffset(10, 0),
        Size = UDim2.fromOffset(Inner, 22),
        Text = Params.BoxName or "Shared Config",
        TextSize = 15,
        Truncate = true,
        Z = Library.Order.Window + 5
    })

    local Slab = MakeField({
        Parent = Box.Row.Instance,
        Pos = UDim2.fromOffset(10, 25),
        Size = UDim2.fromOffset(Inner, 24),
        Round = 3,
        Z = Library.Order.Window + 5
    })

    local Input = Library:Create("TextBox", {
        Parent = Slab.Instance,
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.fromOffset(Inner - 16, 24),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        FontFace = Library.Font,
        Text = "",
        PlaceholderText = Params.Placeholder or "Paste a shared config here",
        PlaceholderColor3 = Shade(Library.Theme.InactiveText, 0.8),
        TextColor3 = Library.Theme.Text,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.None,
        ClearTextOnFocus = false,
        ZIndex = Library.Order.Window + 6
    }):AddToTheme({
        TextColor3 = "Text"
    })

    Library:SeedResting(Input.Instance)

    local function Announce(Text)
        Library:Notify({
            Title = Params.Name or "Share Config",
            Text = Text
        })
    end

    Action(Params.CopyText or "Copy Config", function()
        if not Picked then
            Announce("Select a config first")
            return
        end

        local Path = Folder .. Picked .. ".json"

        if not (type(isfile) == "function" and isfile(Path)) then
            Announce("Config not found")
            return
        end

        local Ok, Decoded = pcall(function()
            return HttpService:JSONDecode(readfile(Path))
        end)

        if not Ok or type(Decoded) ~= "table" then
            Announce("Bad config file")
            return
        end

        local Out = {}

        for Key, Value in next, Decoded do
            local Keep = false

            if type(Key) == "string" and Key:sub(1, 12) == "ShareConfig_" then
                Keep = false
            elseif type(Value) == "boolean" then
                Keep = Value == true
            elseif type(Value) == "number" then
                Keep = true
            elseif type(Value) == "string" then
                Keep = Value ~= "" and Value ~= "..."
            elseif type(Value) == "table" then
                Keep = true
            end

            if Keep then
                Out[Key] = Value
            end
        end

        local Code = HttpService:JSONEncode(Out)
        Input.Instance.Text = Code

        if type(setclipboard) == "function" then
            pcall(setclipboard, Code)
            Announce("Config copied to clipboard")
        else
            Announce("Config ready, copy it from the box")
        end
    end)

    Action(Params.LoadText or "Load Config", function()
        local Raw = Input.Instance.Text

        if not Raw or Raw:gsub("%s", "") == "" then
            Announce("Paste a config first")
            return
        end

        local Ok = Library:ImportConfig(Raw)
        Announce(Ok and "Shared config loaded" or "Invalid shared config")
    end)

    Section.Refresh = Refresh
    Section.Input = Input

    Refresh()
    Section:Reflow()

    return Section
end
function Library:ConfigTab(Params)
    Params = Params or {}

    local Window = self
    local Tab = Window:Tab({
        Name = Params.Name or "Settings",
        Icon = Params.Icon or "rbxassetid://10734950020"
    })

    local Profiles = Tab:Section({
        Name = "Profiles",
        Side = 1
    })

    local Theming = Tab:Section({
        Name = "Theming",
        Side = 2
    })

    Profiles:Label({
        Name = "Configs",
        Dim = true
    })

    local ConfigList = Profiles:List({
        Rows = 6
    })

    local ConfigName = Profiles:Textbox({
        Name = "Config Name",
        Placeholder = "Config name",
        Flag = "BlossomConfigName"
    })

    local function Reload()
        ConfigList:Refresh(Library:ConfigList())
    end

    Profiles:Button({
        Name = "Create",
        Callback = function()
            local Name = ConfigName.Value

            if Name == "" then
                Library:Notify({
                    Title = "Configs",
                    Text = "Enter a config name first"
                })

                return
            end

            Library:SaveConfig(Name)
            Reload()

            Library:Notify({
                Title = "Configs",
                Text = "Created " .. Name
            })
        end
    })

    Profiles:Button({
        Name = "Load",
        Callback = function()
            local Name = ConfigList.Value

            if not Name then
                Library:Notify({
                    Title = "Configs",
                    Text = "Select a config first"
                })

                return
            end

            local Path = Library.Directory .. Library.Folders.Configs .. "/" .. Name .. ".json"

            if not isfile(Path) then
                return
            end

            Library:LoadConfig(readfile(Path))

            Library:Notify({
                Title = "Configs",
                Text = "Loaded " .. Name
            })
        end
    })

    Profiles:Button({
        Name = "Delete",
        Callback = function()
            local Name = ConfigList.Value

            if not Name then
                return
            end

            Library:DeleteConfig(Name)
            Reload()

            Library:Notify({
                Title = "Configs",
                Text = "Deleted " .. Name
            })
        end
    })

    Profiles:Button({
        Name = "Overwrite",
        Callback = function()
            local Name = ConfigList.Value

            if not Name then
                return
            end

            Library:SaveConfig(Name)

            Library:Notify({
                Title = "Configs",
                Text = "Overwrote " .. Name
            })
        end
    })

    local ThemeNames = {}

    for Name in next, Library.Themes do
        table.insert(ThemeNames, Name)
    end

    table.sort(ThemeNames)

    local Swatches = {}

    local ThemeDropdown = Theming:Dropdown({
        Name = "Theme",
        Flag = "BlossomTheme",
        Items = ThemeNames,
        Default = Library.ThemeName,
        Callback = function(Value)
            Library:ApplyTheme(Value)

            for Key, Picker in next, Swatches do
                Picker:Set(Library.Theme[Key], nil, true)
            end
        end
    })

    Theming:Divider()

    for _, Key in next, ThemeOrder do
        local Row = Theming:Label({
            Name = ThemeLabels[Key],
            Dim = true
        })

        Swatches[Key] = Row:Colorpicker({
            Name = ThemeLabels[Key],
            Flag = "BlossomTheme" .. Key,
            Default = Library.Theme[Key],
            Callback = function(Color)
                Library:ChangeTheme(Key, Color)
            end
        })
    end

    local Menu = Tab:Section({
        Name = "Menu",
        Side = 2
    })

    Menu:Label({
        Name = "Menu Keybind",
        Dim = true
    }):Keybind({
        Name = "Menu",
        Default = Library.MenuKeybind,
        Changed = function(Key)
            Library.MenuKeybind = Key
        end
    })

    Menu:Toggle({
        Name = "Watermark",
        Flag = "BlossomWatermark",
        Default = true,
        Callback = function(Value)
            Library:WatermarkVisible(Value)
        end
    })

    Menu:Toggle({
        Name = "Hotkeys Panel",
        Flag = "BlossomHotkeys",
        Default = true,
        Callback = function(Value)
            Library:HotkeysVisible(Value)
        end
    })

    Menu:Button({
        Name = "Unload",
        Callback = function()
            Library:Exit()
        end
    })

    local Autoload = Tab:Section({
        Name = "Autoload",
        Side = 1
    })

    local AutoPath = Library.Directory .. Library.Folders.Configs .. "/autoload.txt"

    local AutoLabel = Autoload:Label({
        Name = isfile(AutoPath) and ("Autoload: " .. readfile(AutoPath)) or "Autoload: none",
        Dim = true
    })

    Autoload:Button({
        Name = "Set Autoload",
        Callback = function()
            local Name = ConfigList.Value

            if not Name then
                return
            end

            writefile(AutoPath, Name)
            AutoLabel:Set("Autoload: " .. Name)
        end
    })

    Autoload:Button({
        Name = "Clear Autoload",
        Callback = function()
            if isfile(AutoPath) then
                delfile(AutoPath)
            end

            AutoLabel:Set("Autoload: none")
        end
    })

    Reload()

    Library.OnThemeApplied = function(Name)
        if ThemeDropdown.Value ~= Name then
            ThemeDropdown:Set(Name, true)
        end
    end

    function Library:RunAutoload()
        if not isfile(AutoPath) then
            return
        end

        local Name = readfile(AutoPath)
        local Path = Library.Directory .. Library.Folders.Configs .. "/" .. Name .. ".json"

        if isfile(Path) then
            Library:LoadConfig(readfile(Path))
            ConfigList:Set(Name)

            Library:Notify({
                Title = "Configs",
                Text = "Autoloaded " .. Name
            })
        end
    end

    return Tab
end

if IsMobile then
    local Pill = MakeButton({
        Parent = Root,
        Pos = UDim2.new(0.05, 0, 0.42, 0),
        Size = UDim2.fromOffset(46, 46),
        Color = "Tab",
        Transparency = 0,
        Round = 23,
        Stroke = true,
        Z = Library.Order.Notification + 10
    })

    local PillIcon = MakeImage({
        Parent = Pill.Instance,
        Pos = UDim2.fromOffset(11, 11),
        Size = UDim2.fromOffset(24, 24),
        Image = Library.Icons.Hub,
        Z = Library.Order.Notification + 11
    })

    Library.MobilePillIcon = PillIcon

    Pill:MakeDraggable()

    local Moved = false
    local Origin

    Pill:Connect("InputBegan", function(Input)
        if Input.UserInputType == Enum.UserInputType.Touch then
            Moved = false
            Origin = Input.Position
        end
    end)

    Library:Connect(UserInputService.InputChanged, function(Input)
        if Input.UserInputType == Enum.UserInputType.Touch and Origin then
            if (Input.Position - Origin).Magnitude > 8 then
                Moved = true
            end
        end
    end)

    Pill:Connect("InputEnded", function(Input)
        if Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if not Moved and Library.Window then
            Library.Window:SetVisible(not Library.Toggled)
        end

        Origin = nil
    end)

    Library.MobilePill = Pill
end

return Library
