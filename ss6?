    Library.CursorHeld = false
    Library.CursorAnywhere = true
    Library.CameraKeys = {
        Enum.UserInputType.MouseButton2,
        Enum.KeyCode.LeftAlt
    }

    local function CameraGesture()
        if IsMobile or Library.Unloaded then
            return false
        end

        for Index = 1, #Library.CameraKeys do
            if Library:KeyDown(Library.CameraKeys[Index]) then
                return true
            end
        end

        return false
    end

    local function CursorWanted()
        if not Library.FreeCursor or Library.Unloaded then
            return false
        end

        if CameraGesture() then
            return false
        end

        if Library.SearchOverlay and Library.SearchOverlay.Instance.Visible then
            return true
        end

        for Popup in next, Library.OpenFrames do
            if Popup.Holder and Popup.Holder.Instance.Visible then
                return true
            end
        end

        if not Library.Toggled or not Shell.Instance.Visible then
            return false
        end

        if Library.CursorAnywhere then
            return true
        end

        return Library:MouseOverUi()
    end

    local function ReleaseCursor()
        Library.CursorHeld = false
    end

    local function HoldCursor()
        if not CursorWanted() then
            ReleaseCursor()
            return
        end

        Library.CursorHeld = true

        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end

        if not UserInputService.MouseIconEnabled then
            UserInputService.MouseIconEnabled = true
        end
    end

    Library.ReleaseCursor = ReleaseCursor
    Library.CursorWanted = CursorWanted
    Library.CameraGesture = CameraGesture

    Library:Connect(RunService.RenderStepped, HoldCursor)

    Library:Connect(UserInputService:GetPropertyChangedSignal("MouseBehavior"), HoldCursor)
    Library:Connect(UserInputService:GetPropertyChangedSignal("MouseIconEnabled"), HoldCursor)

    if Library.SearchOverlay then
        Library.SearchOverlay.Instance.Parent = Main.Instance
        Library.SearchOverlay.Instance.Size = UDim2.fromScale(1, 1)
        Library.SearchOverlay.Instance.Position = UDim2.fromOffset(0, 0)
    end

    Library:PaintBrandIcon(Window.WatermarkIcon)
    Library:SetWatermarkName(Window.Name)

    Library:Thread(function()
        Library:SetWatermark(Library:GameLabel())
    end)

    Shell.Instance.Visible = false
    Library.Booted = false

    function Library:Boot()
        if Library.Booted then
            return
        end

        Library.Booted = true

        UpdateScale()
        Center()

        if Window.ToggleToken ~= 0 or not Library.Toggled then
            return
        end

        Library:FadeGroup(Shell.Instance, true, nil, ShowFade)

        if Library.WatermarkWanted then
            Watermark.Instance.Visible = true
            Library:FadeGroup(Watermark.Instance, true, nil, ShowFade)
        end

        if HotkeyStack.Instance.Visible then
            Library:FadeGroup(HotkeyStack.Instance, true, nil, ShowFade)
        end
    end

    Library:Thread(function()
        local Deadline = os.clock() + 4
        local Settled = 0

        while os.clock() < Deadline do
            local Count = #Window.Tabs

            task.wait(0.12)

            if Count > 0 and #Window.Tabs == Count then
                Settled = Settled + 1

                if Settled >= 2 then
                    break
                end
            else
                Settled = 0
            end
        end

        Library:Boot()
    end)

    return Window
end

