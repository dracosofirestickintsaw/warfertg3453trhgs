local function ClearLetter(Letter, Index)
    local Up = Index % 2 == 1

    Library:Tween({
        Position = UDim2.fromOffset(Letter.X, Up and 30 or -30),
        TextTransparency = 1
    }, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), Letter.Object.Instance)

    task.delay(0.24, function()
        if Letter.Object.Instance then
            Letter.Object.Instance:Destroy()
        end
    end)
end

local function SetHeading(Text)
    if Text == HeadingText then
        return
    end

    local Shared = 0
    local Limit = math.min(#Text, #HeadingText)

    while Shared < Limit and Text:sub(Shared + 1, Shared + 1) == HeadingText:sub(Shared + 1, Shared + 1) do
        Shared = Shared + 1
    end

    for Index = #HeadingLetters, Shared + 1, -1 do
        ClearLetter(HeadingLetters[Index], Index)
        HeadingLetters[Index] = nil
    end

    local Offset = 0

    for Index = 1, Shared do
        Offset = Offset + HeadingLetters[Index].Width
    end

    for Index = Shared + 1, #Text do
        local Character = Text:sub(Index, Index)
        local Up = Index % 2 == 1

        local Object = MakeText({
            Parent = HeadingHolder.Instance,
            Pos = UDim2.fromOffset(Offset, Up and -30 or 30),
            Size = UDim2.fromOffset(30, 30),
            Text = Character,
            TextSize = 22,
            Align = Enum.TextXAlignment.Left,
            Z = Library.Order.Search + 3
        })

        Object.Instance.TextTransparency = 1

        local Width = Library:TextWidth(Object.Instance)

        if Character == " " then
            Width = 7
        end

        Object.Instance.Size = UDim2.fromOffset(math.max(4, Width) + 1, 30)

        Library:Tween({
            Position = UDim2.fromOffset(Offset, 0),
            TextTransparency = 0
        }, TweenInfo.new(0.26, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), Object.Instance)

        HeadingLetters[Index] = {
            Object = Object,
            X = Offset,
            Width = math.max(4, Width) + 1
        }

        Offset = Offset + math.max(4, Width) + 1
    end

    HeadingText = Text
    HeadingPlaceholder.Instance.Visible = Text == ""
end

