        Round = 10,
        Stroke = true,
        Clip = true,
        Z = Library.Order.Keybind + 1
    })

    Gradient(ShowSwitch, Library:FieldSequence())

    local ShowFill = MakeFrame({
        Parent = ShowSwitch.Instance,
        Size = UDim2.fromScale(1, 1),
        Transparency = 1,
        Round = 10,
        Z = Library.Order.Keybind + 1
    })

    local ShowGradient = Gradient(ShowFill, Library:AccentSequence())
    Library:StampResting(ShowFill.Instance, "BackgroundTransparency", 1)

    table.insert(Library.ThemingStuff, {
        Item = ShowGradient.Instance,
        Properties = {
            Color = function()
                return Library:AccentSequence()
            end
        }
    })

    local ShowKnob = MakeFrame({
        Parent = ShowSwitch.Instance,
        Pos = UDim2.fromOffset(14, 2),
        Size = UDim2.fromOffset(10, 10),
        Round = 50,
        Z = Library.Order.Keybind + 3
    })

    ShowKnob.Instance.BackgroundColor3 = Color3.fromRGB(255, 255, 255)

    local ShowHit = MakeButton({
        Parent = Menu.Instance,
        Pos = UDim2.fromOffset(8, 78),
        Size = UDim2.fromOffset(170, 30),
        Z = Library.Order.Keybind + 3
    })

    local ToggleHit = MakeButton({
        Parent = Menu.Instance,
        Pos = UDim2.fromOffset(8, 10),
        Size = UDim2.fromOffset(85, 26),
        Z = Library.Order.Keybind + 3
    })

    local HoldHit = MakeButton({
        Parent = Menu.Instance,
        Pos = UDim2.fromOffset(93, 10),
        Size = UDim2.fromOffset(85, 26),
        Z = Library.Order.Keybind + 3
    })

    local ResetHit = MakeButton({
        Parent = Menu.Instance,
        Pos = UDim2.fromOffset(8, 44),
        Size = UDim2.fromOffset(170, 26),
        Z = Library.Order.Keybind + 3
    })

    local Popup = AttachPopup(Menu, Hit, Library.Order.Keybind)
    local HotkeyRow = Library:AddHotkeyRow(Name)

    Keybind.Popup = Popup
    Keybind.Field = Field
    Keybind.Label = Label

    local function PaintMode()
        local IsToggle = Keybind.Mode == "Toggle"

        Library:Tween({
            Position = UDim2.fromOffset(IsToggle and 2 or 85, 2)
        }, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), ModePill.Instance)

        Library:Tween({
            TextColor3 = IsToggle and Library.Theme.Text or Library.Theme.InactiveText
        }, nil, ToggleLabel.Instance)

        Library:Tween({
            TextColor3 = IsToggle and Library.Theme.InactiveText or Library.Theme.Text
        }, nil, HoldLabel.Instance)
    end

    local function PaintShow()
        Library:Tween({
            BackgroundTransparency = Keybind.Shown and 0 or 1
        }, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), ShowFill.Instance)

        Library:StampResting(ShowFill.Instance, "BackgroundTransparency", Keybind.Shown and 0 or 1)

        Library:Tween({
            Position = UDim2.fromOffset(Keybind.Shown and 14 or 3, 2)
        }, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), ShowKnob.Instance)
    end

    local function Measure()
        local Bounds = math.ceil(Label.Instance.TextBounds.X)
        local Guess = math.ceil(#Label.Instance.Text * 6.5)
        local Reach = Bounds > 0 and Bounds or Guess
        local NewWidth = math.max(18, Reach + 10)

        if (NewWidth - Reach) % 2 ~= 0 then
            NewWidth = NewWidth + 1
        end

        return NewWidth
    end

    local function Resize(NewWidth)
        if Field.Instance.Size.X.Offset == NewWidth then
            return
        end

        Field.Instance.Size = UDim2.fromOffset(NewWidth, 15)
        Label.Instance.Size = UDim2.fromOffset(NewWidth, 15)
        Hit.Instance.Size = UDim2.fromOffset(NewWidth, 15)

        Adorn.Width = NewWidth
        Element:LayoutAdorns()
    end

    local function PaintKey()
        if Keybind.Capturing then
            Label.Instance.Text = "..."
        else
            Label.Instance.Text = Keybind.Key and Library:KeyLabel(Keybind.Key) or "-"
        end

        Resize(Measure())

        Library:Thread(function()
            task.wait()
            Resize(Measure())
        end)

        Library.Flags[Flag] = {
            Key = Keybind.Key and Library:KeyLabel(Keybind.Key) or "NONE",
            Mode = Keybind.Mode,
            Shown = Keybind.Shown
        }

        HotkeyRow.Update(Keybind.Key, Keybind.Shown)

        if Params.Changed then
            Library:SafeCall(Params.Changed, Keybind.Key, Keybind.Mode)
        end
    end

    function Keybind:SyncActive()
        if Keybind.Mode ~= "Toggle" or not Bind or Element.Value == nil then
            return
        end

        Keybind.Active = Element.Value and true or false
        HotkeyRow.SetActive(Keybind.Active)
    end

    function Keybind:Set(Value)
        if type(Value) == "table" then
            Keybind.Key = Library:KeyFromString(Value.Key)
            Keybind.Mode = Value.Mode or Keybind.Mode

            if Value.Shown ~= nil then
                Keybind.Shown = Value.Shown
            end
        elseif typeof(Value) == "EnumItem" then
            Keybind.Key = Value
        elseif type(Value) == "string" then
            Keybind.Key = Library:KeyFromString(Value:upper())
        else
            Keybind.Key = nil
        end

        PaintKey()
        PaintMode()
        PaintShow()
        Keybind:SyncActive()
    end

    Hit:HoverGradient(Field)

    Hit:Connect("InputBegan", function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton2 then
            Keybind.Capturing = true
            Keybind.CaptureInput = Input
            PaintKey()
            return
        end

        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Popup:Toggle()
        end
    end)

    ToggleHit:Connect("MouseButton1Down", function()
        Keybind.Mode = "Toggle"
        PaintMode()
        PaintKey()
        Keybind:SyncActive()
    end)

    HoldHit:Connect("MouseButton1Down", function()
        Keybind.Mode = "Hold"
        PaintMode()
        PaintKey()

        if Keybind.Active then
            Keybind.Active = false
            HotkeyRow.SetActive(false)
        end
    end)

    ResetHit:Connect("MouseButton1Down", function()
        Library:Tween({
            BackgroundTransparency = 0.25
        }, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), ResetPulse.Instance)

        task.delay(0.1, function()
            Library:Tween({
                BackgroundTransparency = 1
            }, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), ResetPulse.Instance)
        end)

        Keybind.Key = nil
        Keybind.Active = false
        PaintKey()
    end)

    ShowHit:Connect("MouseButton1Down", function()
        Keybind.Shown = not Keybind.Shown
        PaintShow()
        PaintKey()
    end)
    ResetHit:HoverGradient(ResetButton)

    Library:Connect(UserInputService.InputBegan, function(Input, Busy)
        if Keybind.Capturing then
            if Input == Keybind.CaptureInput then
                Keybind.CaptureInput = nil
                return
            end

            local Chosen

            if Input.UserInputType == Enum.UserInputType.Keyboard then
                Chosen = Input.KeyCode
            elseif Input.UserInputType == Enum.UserInputType.MouseButton1
                or Input.UserInputType == Enum.UserInputType.MouseButton2
                or Input.UserInputType == Enum.UserInputType.MouseButton3 then
                Chosen = Input.UserInputType
            end

            if Chosen then
                if Chosen == Enum.KeyCode.Escape or Chosen == Enum.KeyCode.Backspace then
                    Keybind.Key = nil
                else
                    Keybind.Key = Chosen
                end

                Keybind.Capturing = false
                Keybind.CaptureInput = nil
                PaintKey()
            end

            return
        end

        if Busy or not Keybind.Key then
            return
        end

        local Matched = false

        if Input.UserInputType == Enum.UserInputType.Keyboard then
            Matched = Input.KeyCode == Keybind.Key
        else
            Matched = Input.UserInputType == Keybind.Key
        end

        if not Matched then
            return
        end

        if Keybind.Mode == "Hold" then
            Keybind.Active = true
        else
            Keybind.Active = not Keybind.Active
        end

        HotkeyRow.SetActive(Keybind.Active)

        if Params.Callback then
            Library:SafeCall(Params.Callback, Keybind.Active)
        end

        if Bind and Element.Set then
            Element:Set(Keybind.Mode == "Hold" and true or not Element.Value)
        end
    end)

    Library:Connect(UserInputService.InputEnded, function(Input)
        if Keybind.Mode ~= "Hold" or not Keybind.Key or not Keybind.Active then
            return
        end

        local Matched = false

        if Input.UserInputType == Enum.UserInputType.Keyboard then
            Matched = Input.KeyCode == Keybind.Key
        else
            Matched = Input.UserInputType == Keybind.Key
        end

        if not Matched then
            return
        end

        Keybind.Active = false
        HotkeyRow.SetActive(false)

        if Params.Callback then
            Library:SafeCall(Params.Callback, false)
        end

        if Bind and Element.Set then
            Element:Set(false)
        end
    end)

    Library.SetFlags[Flag] = function(Value)
        Keybind:Set(Value)
    end

    table.insert(Library.Keybinds, Keybind)

    PaintMode()
    PaintShow()
    PaintKey()

    Element.KeybindObject = Keybind

    Keybind:SyncActive()
    HotkeyRow.SetActive(Keybind.Active)

    return Keybind
end

