local Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

function Library:Encode64(Raw)
    if type(Raw) ~= "string" then
        return ""
    end

    local Native = (crypt and crypt.base64encode) or (crypt and crypt.base64 and crypt.base64.encode) or base64encode

    if type(Native) == "function" then
        local Ok, Out = pcall(Native, Raw)

        if Ok and type(Out) == "string" then
            return Out
        end
    end

    local Parts = {}

    for Index = 1, #Raw, 3 do
        local A = Raw:byte(Index) or 0
        local B = Raw:byte(Index + 1)
        local C = Raw:byte(Index + 2)
        local Block = A * 65536 + (B or 0) * 256 + (C or 0)

        local One = math.floor(Block / 262144) % 64
        local Two = math.floor(Block / 4096) % 64
        local Three = math.floor(Block / 64) % 64
        local Four = Block % 64

        Parts[#Parts + 1] = Alphabet:sub(One + 1, One + 1)
        Parts[#Parts + 1] = Alphabet:sub(Two + 1, Two + 1)
        Parts[#Parts + 1] = B and Alphabet:sub(Three + 1, Three + 1) or "="
        Parts[#Parts + 1] = C and Alphabet:sub(Four + 1, Four + 1) or "="
    end

    return table.concat(Parts)
end

function Library:Decode64(Code)
    if type(Code) ~= "string" then
        return ""
    end

    local Native = (crypt and crypt.base64decode) or (crypt and crypt.base64 and crypt.base64.decode) or base64decode

    if type(Native) == "function" then
        local Ok, Out = pcall(Native, Code)

        if Ok and type(Out) == "string" and Out ~= "" then
            return Out
        end
    end

    local Clean = Code:gsub("[^%w%+/=]", "")
    local Parts = {}

    for Index = 1, #Clean, 4 do
        local Slice = Clean:sub(Index, Index + 3)
        local Block = 0
        local Pad = 0

        for Step = 1, 4 do
            local Char = Slice:sub(Step, Step)

            if Char == "=" or Char == "" then
                Pad = Pad + 1
                Block = Block * 64
            else
                local At = Alphabet:find(Char, 1, true)

                if not At then
                    return ""
                end

                Block = Block * 64 + (At - 1)
            end
        end

        local A = math.floor(Block / 65536) % 256
        local B = math.floor(Block / 256) % 256
        local C = Block % 256

        Parts[#Parts + 1] = string.char(A)

        if Pad < 2 then
            Parts[#Parts + 1] = string.char(B)
        end

        if Pad < 1 then
            Parts[#Parts + 1] = string.char(C)
        end
    end

    return table.concat(Parts)
end

function Library:ExportConfig()
    local Ok, Raw = pcall(function()
        return Library:GetConfig()
    end)

    if not Ok or type(Raw) ~= "string" then
        return nil
    end

    return "BLOSSOM-" .. Library:Encode64(Raw)
end

function Library:ImportConfig(Code)
    if type(Code) ~= "string" then
        return false, "empty code"
    end

    local Clean = Code:gsub("%s", "")

    if Clean == "" then
        return false, "empty code"
    end

    if Clean:sub(1, 1) == "{" then
        return Library:LoadConfig(Code)
    end

    if Clean:sub(1, 8):upper() == "BLOSSOM-" then
        Clean = Clean:sub(9)
    end

    local Raw = Library:Decode64(Clean)

    if Raw == "" or not Raw:find("{", 1, true) then
        return false, "not a valid share code"
    end

    return Library:LoadConfig(Raw)
end

function Library:ShareConfig(Params)
