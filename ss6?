        Clip = true,
        Visible = false,
        Z = Library.Order.Popup
    })

    local Scroll = MakeScroll({
        Parent = ListFrame.Instance,
        Pos = UDim2.fromOffset(0, HeadTall),
        Size = UDim2.fromOffset(InnerWidth, 24),
        Bar = true,
        Z = Library.Order.Popup + 1
    })

    local Query = ""
    local SearchInput

    if Searchable then
        local Head = MakeField({
            Parent = ListFrame.Instance,
            Pos = UDim2.fromOffset(4, 4),
            Size = UDim2.fromOffset(InnerWidth - 8, 20),
            Round = 3,
            Z = Library.Order.Popup + 1
        })

        local Glass = MakeImage({
            Parent = Head.Instance,
            Pos = UDim2.fromOffset(6, 5),
            Size = UDim2.fromOffset(11, 11),
            Icon = "search",
            Color = "InactiveText",
            Z = Library.Order.Popup + 2
        })

        SearchInput = Library:Create("TextBox", {
            Parent = Head.Instance,
            Position = UDim2.fromOffset(22, 0),
            Size = UDim2.fromOffset(InnerWidth - 34, 20),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            FontFace = Library.Font,
            Text = "",
            PlaceholderText = "Search",
            PlaceholderColor3 = Shade(Library.Theme.InactiveText, 0.8),
            TextColor3 = Library.Theme.Text,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.None,
            ClearTextOnFocus = false,
            ZIndex = Library.Order.Popup + 2
        }):AddToTheme({
            TextColor3 = "Text"
        })

        Library:SeedResting(Head.Instance)
        Library:SeedResting(Glass.Instance)
        Library:SeedResting(SearchInput.Instance)
    end

    Element.NameLabel = Text
    Element.Field = Field
    Element.Display = Display
    Element.ListFrame = ListFrame
    Element.Slot = SectionWidth - 12

    local PaintRows

    local Popup = AttachPopup(ListFrame, Hit)
    Element.Popup = Popup

    Popup.OnState = function(State)
        Library:Tween({
            Rotation = State and -90 or 0
        }, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), Arrow.Instance)

        if State and PaintRows then
            PaintRows()
        elseif not State and Searchable then
            SearchInput.Instance.Text = ""
        end
    end

    Hit:HoverGradient(Field)

    Hit:Connect("MouseButton1Down", function()
        Popup:Toggle()
    end)

    local Rows = {}

    local function Selected(Item)
        if Multi then
            return table.find(Element.Value, Item) ~= nil
        end

        return Element.Value == Item
    end

    local function UpdateDisplay()
        if Multi then
            if #Element.Value == 0 then
                Display.Instance.Text = "None"
            else
                Display.Instance.Text = table.concat(Element.Value, ", ")
            end
        else
            Display.Instance.Text = Element.Value ~= nil and tostring(Element.Value) or "None"
        end
    end

    function PaintRows()
        for _, Row in next, Rows do
            local On = Selected(Row.Item)

            Library:Tween({
                BackgroundTransparency = On and 0 or 1
            }, FadeInfo, Row.Frame.Instance)

            Row.Label.Instance.TextColor3 = On and Library.Theme.Text or Library.Theme.InactiveText

            Library:Tween({
                Position = UDim2.fromOffset(On and 16 or 6, 0)
            }, SlideInfo, Row.Label.Instance)

            Library:Tween({
                BackgroundTransparency = On and 0 or 1
            }, FadeInfo, Row.Line.Instance)

            Library:Tween({
                Size = UDim2.fromOffset(On and 3 or 0, 14)
            }, SlideInfo, Row.Line.Instance)

            Library:StampResting(Row.Frame.Instance, "BackgroundTransparency", On and 0 or 1)
            Library:StampResting(Row.Line.Instance, "BackgroundTransparency", On and 0 or 1)
        end
    end

    function Element:Layout()
        local Y = 0

        for _, Row in next, Rows do
            local Keep = Query == "" or Row.Lower:find(Query, 1, true) ~= nil

            Row.Frame.Instance.Visible = Keep

            if Keep then
                Row.Frame.Instance.Position = UDim2.fromOffset(0, Y)
                Y = Y + 24
            end
        end

        local Visible = math.min(math.max(Y, 24), 8 * 24)

        ListFrame.Instance.Size = UDim2.fromOffset(InnerWidth, Visible + HeadTall)
        Scroll.Instance.Size = UDim2.fromOffset(InnerWidth, Visible)
        Scroll.Instance.CanvasSize = UDim2.fromOffset(0, Y)
    end

    if Searchable then
        Library:Connect(SearchInput.Instance:GetPropertyChangedSignal("Text"), function()
            Query = SearchInput.Instance.Text:lower()
            Element:Layout()
        end)
    end

    function Element:Refresh(Items)
        Element.Items = Items or Element.Items

        for _, Row in next, Rows do
            Row.Frame.Instance:Destroy()
        end

        table.clear(Rows)

        for _, Item in next, Element.Items do
            local Frame = MakeFrame({
                Parent = Scroll.Instance,
                Pos = UDim2.fromOffset(0, 0),
                Size = UDim2.fromOffset(InnerWidth, 24),
                Color = "Element",
                Transparency = 1,
                Z = Library.Order.Popup + 2
            })

            local Label = MakeText({
                Parent = Frame.Instance,
                Pos = UDim2.fromOffset(6, 0),
                Size = UDim2.fromOffset(InnerWidth - 20, 24),
                Text = tostring(Item),
                TextSize = 15,
                Color = "InactiveText",
                Truncate = true,
                Z = Library.Order.Popup + 3
            })

            local Entry = Library.ThemeMap[Label.Instance]

            if Entry then
                Entry.Properties.TextColor3 = function()
                    return Selected(Item) and Library.Theme.Text or Library.Theme.InactiveText
                end
            end

            local Line = MakeFrame({
                Parent = Frame.Instance,
                Pos = UDim2.fromOffset(6, 5),
                Size = UDim2.fromOffset(0, 14),
                Transparency = 1,
                Round = 20,
                Z = Library.Order.Popup + 3
            })

            local LineGradient = Gradient(Line, Library:AccentSequence())
            Library:StampResting(Line.Instance, "BackgroundTransparency", 1)

            table.insert(Library.ThemingStuff, {
                Item = LineGradient.Instance,
                Properties = {
                    Color = function()
                        return Library:AccentSequence()
                    end
                }
            })

            local RowHit = MakeButton({
                Parent = Frame.Instance,
                Size = UDim2.fromOffset(InnerWidth, 24),
                Z = Library.Order.Popup + 4
            })

            RowHit:Hover(function()
                if not Selected(Item) then
                    Library:Tween({
                        BackgroundTransparency = 0.65
                    }, FadeInfo, Frame.Instance)
                end
            end, function()
                if not Selected(Item) then
                    Library:Tween({
                        BackgroundTransparency = 1
                    }, FadeInfo, Frame.Instance)
                end
            end)

            RowHit:Connect("MouseButton1Down", function()
                if not Multi then
                    Element:Set(Item)
                    return
                end

                local Picked = {}

                for _, Existing in next, Element.Value do
                    table.insert(Picked, Existing)
                end

                local At = table.find(Picked, Item)

                if At then
                    table.remove(Picked, At)
                else
                    table.insert(Picked, Item)
                end

                Element:Set(Picked)
            end)

            table.insert(Rows, {
                Item = Item,
                Lower = tostring(Item):lower(),
                Frame = Frame,
                Label = Label,
                Line = Line
            })
        end

        Element:Layout()
        UpdateDisplay()
        PaintRows()
    end

    function Element:Set(Value, Silent)
        if Multi then
            local Picked = {}

            if type(Value) == "table" then
                for Index = 1, #Value do
                    if Value[Index] ~= nil then
                        table.insert(Picked, Value[Index])
                    end
                end

                if #Picked == 0 then
                    for _, Item in next, Value do
                        table.insert(Picked, Item)
                    end
                end
            end

            Element.Value = Picked
        else
            Element.Value = Value
        end

        Library.Flags[Flag] = Element.Value
        UpdateDisplay()
        PaintRows()

        if not Silent and Params.Callback then
            Library:SafeCall(Params.Callback, Element.Value)
        end
    end

    Library.SetFlags[Flag] = function(Value)
        Element:Set(Value)
    end

    Element:Refresh(Element.Items)

    if Params.Default ~= nil then
        Element:Set(Params.Default, true)
    end

    Section:Reflow()
    return Element
end

