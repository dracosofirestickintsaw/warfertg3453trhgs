local function ValidPack(Pack)
    return type(Pack) == "table" and type(Pack.GetAsset) == "function"
end

local function RunPack(Source)
    if type(Source) ~= "string" or #Source < 4096 then
        return nil
    end

    local Ok, Chunk = pcall(loadstring, Source)

    if not Ok or type(Chunk) ~= "function" then
        return nil
    end

    local Ran, Pack = pcall(Chunk)

    if Ran and ValidPack(Pack) then
        return Pack
    end

    return nil
end

function Library:LoadLucide()
    if Library.LucideTried then
        return Library.Lucide
    end

    Library.LucideTried = true

    local Path = Library.Directory .. Library.Folders.Assets .. Library.LucideCache
    local Pack

    pcall(function()
        if isfile(Path) then
            Pack = RunPack(readfile(Path))
        end
    end)

    if not Pack then
        for _, Url in next, Library.LucideSources do
            local Body

            pcall(function()
                Body = game:HttpGet(Url)
            end)

            Pack = RunPack(Body)

            if Pack then
                pcall(function()
                    writefile(Path, Body)
                end)

                break
            end
        end
    end

    if not Pack then
        return nil
    end

    Library.Lucide = Pack

    local Names = {}

    pcall(function()
        for _, Entry in next, Pack.IconNames or {} do
            Names[Entry] = true
        end
    end)

    if next(Names) then
        Library.LucideNames = Names
    end

    return Pack
end

function Library:LucideIcon(Name)
    if type(Name) ~= "string" or Name == "" then
        return nil
    end

    local Pack = Library:LoadLucide()

    if not Pack then
        return nil
    end

    if Library.LucideNames and not Library.LucideNames[Name] then
        return nil
    end

    local Entry

    pcall(function()
        Entry = Pack.GetAsset(Name, Library.LucideSize)
    end)

    if type(Entry) ~= "table" then
        return nil
    end

    local Found = Entry.Url

    if type(Found) ~= "string" and type(Entry.Id) == "number" then
        Found = "rbxassetid://" .. Entry.Id
    end

    if type(Found) ~= "string" or Found == "" then
        return nil
    end

    return Found, Entry.ImageRectOffset, Entry.ImageRectSize
end

function Library:IconInfo(Icon)
    if not Icon then
        return Library.Icons.Tab
    end

    if type(Icon) == "number" then
        return "rbxassetid://" .. Icon
    end

    if type(Icon) ~= "string" then
        return Library.Icons.Tab
    end

    if Icon:match("^%d+$") then
        return "rbxassetid://" .. Icon
    end

    if Library.Icons[Icon] then
        return Library.Icons[Icon]
    end

    if Icon:match("^rbxasset") or Icon:match("^http") then
        return Icon
    end

    local Image, Offset, Size = Library:LucideIcon(Icon)

    if Image then
        return Image, Offset, Size
    end

    return Library:FallbackIcon(Icon) or Library.Icons.Tab
end

function Library:PaintIcon(Object, Icon)
    if not Object then
        return
    end

    local Image, Offset, Size = Library:IconInfo(Icon)

    Object.Image = Image or ""

    if typeof(Offset) == "Vector2" and typeof(Size) == "Vector2" and Size.X > 0 then
        Object.ImageRectOffset = Offset
        Object.ImageRectSize = Size
    else
        Object.ImageRectOffset = Vector2.new(0, 0)
        Object.ImageRectSize = Vector2.new(0, 0)
    end
end

function Library:ResolveIcon(Icon)
    if not Icon then
        return Library.Icons.Tab
    end

    if type(Icon) == "number" then
        return "rbxassetid://" .. Icon
    end

    if type(Icon) == "string" then
        if Icon:match("^%d+$") then
            return "rbxassetid://" .. Icon
        end

        if Library.Icons[Icon] then
            return Library.Icons[Icon]
        end

        if Icon:match("^rbxasset") or Icon:match("^http") then
            return Icon
        end

        local Lucide = Library:LucideIcon(Icon)

        if Lucide then
            return Lucide
        end

        return Library:FallbackIcon(Icon) or Library.Icons.Tab
    end

    return Library.Icons.Tab
end

function Library:ResolveAsset(Value)
    if type(Value) == "number" then
        return "rbxassetid://" .. Value
    end

    if type(Value) ~= "string" then
        return ""
    end

    if Value:match("^%d+$") then
        return "rbxassetid://" .. Value
    end

    return Value
end

function Library:GameLabel()
    local Name = "Roblox"

    pcall(function()
        Name = MarketplaceService:GetProductInfo(game.PlaceId).Name
    end)

    return Name .. " | " .. LocalPlayer.Name
end

function Library:CloseAllPopups()
    for Popup in next, Library.OpenFrames do
        if Popup.SetOpen then
            Popup:SetOpen(false)
        end
    end
end


local SlideInfo = TweenInfo.new(0.14, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local FadeInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local ToggleFade = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local ToggleSlide = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SectionSlide = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local SectionDrag = TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local DetachedList = {}

local function RestackDetached()
    local Count = #DetachedList

    for Index = 1, Count do
        local Entry = DetachedList[Index]
        local Slot = Library.Order.Detached + (Count - Index) * 12

        Entry.Apply(math.min(Slot, Library.Order.DetachedTop))
    end
end

local function RegisterSearch(Data)
    table.insert(Library.SearchItems, Data)
end

function Library:LayoutColumn(Index, Smooth)
    local Tab = self
    local Running = 0
    local Slot = 0
    local Reserve = Tab.Reserve and Tab.Reserve[Index]

    if Index == 3 then
        Running = math.max(Tab.Heights[1] or 0, Tab.Heights[2] or 0)
    end

    for Position = 1, #Tab.Sections do
        local Other = Tab.Sections[Position]

        if Other.Side ~= Index or Other.Detached or Other.Dragging then
            continue
        end

        if Reserve and Reserve.At == Slot then
            Reserve.Y = Running
            Running = Running + Reserve.Height + 12
        end

        Other.Top = Running

        local Target = UDim2.fromOffset(SectionOffset[Index], Running)

        if Smooth then
            Library:Tween({
                Position = Target
            }, SectionSlide, Other.Holder.Instance)
        else
            Other.Holder.Instance.Position = Target
        end

        Running = Running + 30 + Other.Height + 12
        Slot = Slot + 1
    end

    if Reserve and Reserve.At >= Slot then
        Reserve.Y = Running
        Running = Running + Reserve.Height + 12
    end

    Tab.Heights[Index] = Running

    if Index ~= 3 and Tab.WideMode then
        Tab:LayoutColumn(3, Smooth)
        return
    end

    if Tab.Window.Current == Tab then
        Tab.Window:Reflow()
    end
end

function Library:Section(Params)
    Params = Params or {}

    local Tab = self
    local Window = Tab.Window
    local IsWide = (Params.OneColumn or Params.Wide) and true or false
    local Index = IsWide and 3 or math.clamp(Params.Side or 1, 1, 2)
    local Width = IsWide and WideWidth or SectionWidth

    Tab.Reserve = Tab.Reserve or {}

    if IsWide then
        Window:GoWide(Tab)
    end

    local Section = setmetatable({
        NameText = Params.Name or "Section",
        Tab = Tab,
        Window = Window,
        Side = Index,
        Elements = {},
        Height = 8,
        Top = 0,
        Detached = false,
        Dragging = false
    }, Library)

    local Holder = MakeFrame({
        Parent = Tab.Pages[Index].Instance,
        Pos = UDim2.fromOffset(SectionOffset[Index], 0),
        Size = UDim2.fromOffset(Width, 38),
        Transparency = 1,
        Z = Library.Order.Window + 3
    })

    local HolderScale = Library:Create("UIScale", {
        Parent = Holder.Instance,
        Scale = 1
    })

    local TitleIcon = MakeImage({
        Parent = Holder.Instance,
        Pos = UDim2.fromOffset(0, 9),
        Size = UDim2.fromOffset(14, 14),
        Icon = Params.Icon or Library.Icons.Section,
        Color = "InactiveText",
        Z = Library.Order.Window + 3
    })

    local TitleLabel = MakeText({
        Parent = Holder.Instance,
        Pos = UDim2.fromOffset(22, 6),
        Size = UDim2.fromOffset(Width - 26, 20),
        Text = Section.NameText,
        TextSize = 15,
        Color = "InactiveText",
        Truncate = true,
        Z = Library.Order.Window + 3
    })

    local Frame = MakeFrame({
        Parent = Holder.Instance,
        Pos = UDim2.fromOffset(0, 30),
        Size = UDim2.fromOffset(Width, 8),
        Color = "Element",
        Round = 5,
        Stroke = true,
        Z = Library.Order.Window + 3
    })

    Section.Width = Width
    Section.Wide = IsWide
    Section.Holder = Holder
    Section.HolderScale = HolderScale
    Section.TitleIcon = TitleIcon
    Section.TitleLabel = TitleLabel
    Section.Frame = Frame

    RegisterSearch({
        Kind = "Section",
        Name = Section.NameText,
        Path = Tab.Name,
        Tab = Tab,
        Section = Section
    })

    function Section:Reflow()
        local Y = 6

        for Position = 1, #Section.Elements do
            local Element = Section.Elements[Position]

            if not Element.Row.Instance.Visible then
                continue
            end

            Element.Row.Instance.Position = UDim2.fromOffset(0, Y)
            Y = Y + Element.Height
        end

        Section.Height = Y + 4
        Frame.Instance.Size = UDim2.fromOffset(Width, Section.Height)
        Holder.Instance.Size = UDim2.fromOffset(Width, 30 + Section.Height)

        Section.Tab:LayoutColumn(Section.Side)
    end

    function Section:NewRow(Height, Name, Kind)
        local Row = MakeFrame({
            Parent = Frame.Instance,
            Size = UDim2.fromOffset(Width, Height),
            Transparency = 1,
            Z = Library.Order.Window + 4
        })

        local Element = setmetatable({
            Row = Row,
            Height = Height,
            Section = Section,
            Slot = Width - 12,
            Adorn = {},
            Name = Name
        }, Library)

        function Element:LayoutAdorns()
            local Right = Element.Slot

            for Index = 1, #Element.Adorn do
                local Item = Element.Adorn[Index]

                Right = Right - Item.Width
                Item.Place(Right)
                Right = Right - 5
            end
        end

        function Element:AddAdorn(Item)
            table.insert(Element.Adorn, Item)
            Element:LayoutAdorns()

            return Item
        end

        table.insert(Section.Elements, Element)

        if Name then
            RegisterSearch({
                Kind = Kind or "Element",
                Name = Name,
                Path = Tab.Name .. " / " .. Section.NameText,
                Tab = Tab,
                Section = Section,
                Element = Element
            })
        end

        return Element
    end

    table.insert(Tab.Sections, Section)

    if not IsMobile and not IsWide then
        local GrabWidth = math.clamp(math.floor(TitleLabel.Instance.TextBounds.X) + 30, 60, Width)

        local TitleHit = MakeButton({
            Parent = Holder.Instance,
            Pos = UDim2.fromOffset(0, 4),
            Size = UDim2.fromOffset(GrabWidth, 22),
            Z = Library.Order.Window + 12
        })

        local Shadow
        local Ghost
        local Dragging = false
        local GrabX = 0
        local GrabY = 0
        local DropColumn
        local DropIndex

        Section.TitleHit = TitleHit

        local Base = {}

        local function Layer(Offset)
            local Items = Holder.Instance:GetDescendants()
            table.insert(Items, Holder.Instance)

            for Position = 1, #Items do
                local Object = Items[Position]

                if Object:IsA("GuiObject") then
                    if Base[Object] == nil then
                        Base[Object] = Object.ZIndex
                    end

                    Object.ZIndex = Base[Object] + Offset
                end
            end
        end

        local LayerEntry = {
            Apply = Layer
        }

        local function MarkDetached()
            local At = table.find(DetachedList, LayerEntry)

            if At then
                table.remove(DetachedList, At)
            end

            table.insert(DetachedList, LayerEntry)
            RestackDetached()
        end

        local function MarkDocked()
            local At = table.find(DetachedList, LayerEntry)

            if At then
                table.remove(DetachedList, At)
            end

            Layer(0)
            RestackDetached()
        end

        local function Paint(White)
            if (Dragging or Section.Detached) and not White then
                return
            end

            Library:Tween({
                TextColor3 = White and Library.Theme.Text or Library.Theme.InactiveText
            }, FadeInfo, TitleLabel.Instance)

            Library:Tween({
                ImageColor3 = White and Library.Theme.Text or Library.Theme.InactiveText
            }, FadeInfo, TitleIcon.Instance)
        end

        local function LayoutAll(Smooth)
            Section.Tab:LayoutColumn(1, Smooth)
            Section.Tab:LayoutColumn(2, Smooth)

            local Live = Window.Current

            if Live and Live ~= Section.Tab then
                Live:LayoutColumn(1, Smooth)
                Live:LayoutColumn(2, Smooth)
            end
        end

        local function ClearReserve()
            if Section.Tab.Reserve then
                Section.Tab.Reserve[1] = nil
                Section.Tab.Reserve[2] = nil
            end

            local Live = Window.Current

            if Live and Live.Reserve then
                Live.Reserve[1] = nil
                Live.Reserve[2] = nil
            end
        end

        local function DropGhost()
            if Ghost then
                Ghost.Instance:Destroy()
                Ghost = nil
            end
        end

        local function ShowGhost(Column)
            local Live = Window.Current

            if not Live or not Live.Reserve then
                return
            end

            local Reserve = Live.Reserve[Column]

            if not Reserve then
                return
            end

            if not Ghost then
                Ghost = MakeFrame({
                    Parent = Live.Pages[Column].Instance,
                    Transparency = 0.35,
                    Round = 5,
                    Z = Library.Order.Window + 25
                })

                Ghost.Instance.BackgroundColor3 = Lift(Library.Theme.Background, 0.12)
                Stroke(Ghost)

                Ghost:AddToTheme({
                    BackgroundColor3 = function()
                        return Lift(Library.Theme.Background, 0.12)
                    end
                })
            end

            Ghost.Instance.Parent = Live.Pages[Column].Instance
            Ghost.Instance.Position = UDim2.fromOffset(SectionOffset[Column], Reserve.Y)
            Ghost.Instance.Size = UDim2.fromOffset(SectionWidth, Reserve.Height)
        end

        local function Detach()
            local Inset = GuiService:GetGuiInset().Y
            local Origin = Holder.Instance.AbsolutePosition

            Section.Dragging = true
            HolderScale.Instance.Scale = Window.Scaler.Instance.Scale

            Holder.Instance.Parent = Root
            Holder.Instance.Position = UDim2.fromOffset(Origin.X, Origin.Y + Inset)

            if not Shadow then
                Shadow = Library:Create("UIShadow", {
                    Parent = Frame.Instance,
                    BlurRadius = UDim.new(0, 15),
                    Transparency = 1,
                    ZIndex = -2
                })

                Library:StampResting(Shadow.Instance, "Transparency", 0.3)
            end

            Library:Tween({
                Transparency = 0.3
            }, FadeInfo, Shadow.Instance)
        end

        local function Attach(Column, At)
            local NewTab = Window.Current or Section.Tab
            local OldTab = Section.Tab

            local Position = table.find(OldTab.Sections, Section)

            if Position then
                table.remove(OldTab.Sections, Position)
            end

            Section.Tab = NewTab
            Section.Side = Column
            Section.Detached = false
            Section.Dragging = true

            local Seen = 0
            local Target = #NewTab.Sections + 1

            for Scan = 1, #NewTab.Sections do
                local Other = NewTab.Sections[Scan]

                if Other.Side == Column and not Other.Detached then
                    if Seen == At then
                        Target = Scan
                        break
                    end

                    Seen = Seen + 1
                end
            end

            table.insert(NewTab.Sections, Target, Section)

            if OldTab.Reserve then
                OldTab.Reserve[1] = nil
                OldTab.Reserve[2] = nil
            end

            NewTab.Reserve[3 - Column] = nil
            NewTab.Reserve[Column] = {
                At = At,
                Height = 30 + Section.Height
            }

            NewTab:LayoutColumn(Column, true)

            if OldTab ~= NewTab then
                OldTab:LayoutColumn(1, true)
                OldTab:LayoutColumn(2, true)
            end

            local Page = NewTab.Pages[Column].Instance
            local View = Window.Columns[Column].Instance
            local Slot = NewTab.Reserve[Column].Y or 0
            local Scale = math.max(0.01, Window.Scaler.Instance.Scale)
            local Inset = GuiService:GetGuiInset().Y

            local Reach = View.AbsoluteSize.Y / Scale
            local Bottom = Slot + 30 + Section.Height
            local Scroll = View.CanvasPosition.Y

            if Bottom > Scroll + Reach then
                Scroll = math.max(0, Bottom - Reach)
            elseif Slot < Scroll then
                Scroll = Slot
            end

            if math.abs(Scroll - View.CanvasPosition.Y) > 0.5 then
                Library:Tween({
                    CanvasPosition = Vector2.new(0, Scroll)
                }, SectionSlide, View)
            end

            Library:Tween({
                Position = UDim2.fromOffset(
                    View.AbsolutePosition.X + SectionOffset[Column] * Scale,
                    View.AbsolutePosition.Y + (Slot - Scroll) * Scale + Inset
                )
            }, SectionSlide, Holder.Instance)

            if Shadow then
                local Fading = Shadow
                Shadow = nil

                Library:Tween({
                    Transparency = 1
                }, SectionSlide, Fading.Instance)

                task.delay(0.34, function()
                    if Fading.Instance then
                        Fading.Instance:Destroy()
                    end
                end)
            end

            task.delay(0.32, function()
                Section.Dragging = false
                HolderScale.Instance.Scale = 1
                Holder.Instance.Parent = Page

                if NewTab.Reserve then
                    NewTab.Reserve[Column] = nil
                end

                MarkDocked()
                Paint(false)
                NewTab:LayoutColumn(Column)
            end)
        end

        local function Resolve(Position)
            local Live = Window.Current

            if not Live then
                return nil
            end

            local Main = Window.Main.Instance
            local Origin = Main.AbsolutePosition
            local Size = Main.AbsoluteSize

            if Position.X < Origin.X or Position.X > Origin.X + Size.X then
                return nil
            end

            if Position.Y < Origin.Y or Position.Y > Origin.Y + Size.Y then
                return nil
            end

            local Scale = math.max(0.01, Window.Scaler.Instance.Scale)
            local Local = (Position.X - Origin.X) / Scale
            local Column = Local < RailWidth + ColumnWidth and 1 or 2
            local Page = Live.Pages[Column].Instance
            local Inside = (Position.Y - Page.AbsolutePosition.Y) / Scale

            local Slot = 0
            local Running = 0

            for Scan = 1, #Live.Sections do
                local Other = Live.Sections[Scan]

                if Other.Side ~= Column or Other.Detached or Other == Section then
                    continue
                end

                local Full = 30 + Other.Height + 12

                if Inside < Running + Full * 0.5 then
                    return Column, Slot
                end

                Running = Running + Full
                Slot = Slot + 1
            end

            return Column, Slot
        end

        TitleHit:Hover(function()
            Paint(true)
        end, function()
            Paint(false)
        end)

        TitleHit:Connect("InputBegan", function(Input)
            if Input.UserInputType ~= Enum.UserInputType.MouseButton1 then
                return
            end

            local Origin = Holder.Instance.AbsolutePosition

            Dragging = true
            GrabX = Input.Position.X - Origin.X
            GrabY = Input.Position.Y - Origin.Y
            DropColumn = nil
            DropIndex = nil

            Paint(true)
            Detach()
            Layer(Library.Order.Dragging)
            LayoutAll(true)
        end)

        Library:Connect(UserInputService.InputChanged, function(Input)
            if not Dragging or Input.UserInputType ~= Enum.UserInputType.MouseMovement then
                return
            end

            local Inset = GuiService:GetGuiInset().Y

            Library:Tween({
                Position = UDim2.fromOffset(
                    Input.Position.X - GrabX,
                    Input.Position.Y - GrabY + Inset
                )
            }, SectionDrag, Holder.Instance)

            local Column, At = Resolve(Input.Position)

            DropColumn = Column
            DropIndex = At

            ClearReserve()

            if Column then
                local Live = Window.Current
                Live.Reserve[Column] = {
                    At = At,
                    Height = 30 + Section.Height
                }
            end

            LayoutAll(true)

            if Column then
                ShowGhost(Column)
            else
                DropGhost()
            end
        end)

        Library:Connect(UserInputService.InputEnded, function(Input)
            if not Dragging or Input.UserInputType ~= Enum.UserInputType.MouseButton1 then
                return
            end

            Dragging = false
            DropGhost()

            if DropColumn then
                Attach(DropColumn, DropIndex)
                return
            end

            Section.Detached = true
            Section.Dragging = false

            MarkDetached()
            ClearReserve()
            LayoutAll(true)
            Paint(true)
        end)
    end

    if Params.Skins then
        local InnerW = Width - 20
        local Usable = InnerW - 12
        local Columns = math.max(2, math.floor(Usable / 100 + 0.5))
        local CardWide = math.floor((Usable - (Columns - 1) * 8) / Columns)
        local CardTall = math.floor(CardWide * 0.95)
        local Rows = Params.Rows or 2
        local HasSearch = Params.Search ~= false
        local SearchTall = HasSearch and 30 or 0
        local GridTall = Rows * (CardTall + 8) - 8
        local Element = Section:NewRow(GridTall + SearchTall + 14, nil)

        local Query = ""

        if HasSearch then
            local Field = MakeField({
                Parent = Element.Row.Instance,
                Pos = UDim2.fromOffset(10, 4),
                Size = UDim2.fromOffset(InnerW, 24),
                Round = 3,
                Z = Library.Order.Window + 5
            })

            MakeImage({
                Parent = Field.Instance,
                Pos = UDim2.fromOffset(7, 5),
                Size = UDim2.fromOffset(14, 14),
                Image = Library.Icons.Search,
                Color = "InactiveText",
                Z = Library.Order.Window + 6
            })

            local Input = Library:Create("TextBox", {
                Parent = Field.Instance,
                Position = UDim2.fromOffset(27, 0),
                Size = UDim2.fromOffset(InnerW - 34, 24),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                FontFace = Library.Font,
                Text = "",
                PlaceholderText = "Search",
                PlaceholderColor3 = Shade(Library.Theme.InactiveText, 0.8),
                TextColor3 = Library.Theme.Text,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
                ZIndex = Library.Order.Window + 6
            }):AddToTheme({
                TextColor3 = "Text"
            })

            Library:SeedResting(Input.Instance)
            Input:HoverGradient(Field)

            Input:Connect("Changed", function(Property)
                if Property ~= "Text" then
                    return
                end

                Query = Input.Instance.Text:lower()

                if Section.Relayout then
                    Section:Relayout()
                end
            end)

            Section.SearchBox = Input
        end

        local Box = MakeFrame({
            Parent = Element.Row.Instance,
            Pos = UDim2.fromOffset(10, 4 + SearchTall),
            Size = UDim2.fromOffset(InnerW, GridTall + 6),
            Color = "Tab",
            Round = 4,
            Stroke = true,
            Clip = true,
            Z = Library.Order.Window + 5
        })

        local Grid = MakeScroll({
            Parent = Box.Instance,
            Pos = UDim2.fromOffset(4, 3),
            Size = UDim2.fromOffset(InnerW - 8, GridTall),
            Bar = true,
            Z = Library.Order.Window + 6
        })

        local Cards = {}
        local Pending = {}
        local Building = false

        Section.SkinBox = Box
        Section.SkinGrid = Grid
        Section.Value = nil

        local function Matches(Card)
            return Query == "" or Card.Lower:find(Query, 1, true) ~= nil
        end

        local function PaintCard(Card)
            local On = Card.Name == Section.Value

            Library:Tween({
                BackgroundTransparency = On and 0 or 1
            }, FadeInfo, Card.Frame.Instance)

            Library:Tween({
                Transparency = On and 0 or 0.6
            }, FadeInfo, Card.Line.Instance)

            Library:Tween({
                TextColor3 = On and Library.Theme.Text or Library.Theme.InactiveText
            }, FadeInfo, Card.Label.Instance)

            Library:StampResting(Card.Frame.Instance, "BackgroundTransparency", On and 0 or 1)
            Library:StampResting(Card.Line.Instance, "Transparency", On and 0 or 0.6)
        end

        local function PaintCards()
            for Index = 1, #Cards do
                PaintCard(Cards[Index])
            end
        end

        local function Reveal()
            local Top = Grid.Instance.CanvasPosition.Y - CardTall
            local Bottom = Top + Grid.Instance.AbsoluteSize.Y + CardTall * 2

            for Index = 1, #Cards do
                local Card = Cards[Index]

                if Card.Shown and not Card.Loaded then
                    local Y = Card.Frame.Instance.Position.Y.Offset

                    if Y >= Top and Y <= Bottom then
                        Card.Loaded = true
                        Card.Image.Instance.Image = Library:ResolveAsset(Card.Source)
                    end
                end
            end
        end

        function Section:Relayout()
            local Slot = 0

            for Index = 1, #Cards do
                local Card = Cards[Index]
                local Keep = Matches(Card)

                Card.Shown = Keep
                Card.Frame.Instance.Visible = Keep

                if Keep then
                    Card.Frame.Instance.Position = UDim2.fromOffset(
                        (Slot % Columns) * (CardWide + 8),
                        math.floor(Slot / Columns) * (CardTall + 8)
                    )

                    Slot = Slot + 1
                end
            end

            local Lines = math.ceil(Slot / Columns)
            Grid.Instance.CanvasSize = UDim2.fromOffset(0, math.max(0, Lines * (CardTall + 8) - 8))
            Reveal()
        end

        Library:Connect(Grid.Instance:GetPropertyChangedSignal("CanvasPosition"), Reveal)

        local function Build(SkinParams)
            local Name = SkinParams.Name or "Skin"

            local Frame = MakeFrame({
                Parent = Grid.Instance,
                Size = UDim2.fromOffset(CardWide, CardTall),
                Color = "Element",
                Transparency = 1,
                Round = 4,
                Clip = true,
                Visible = false,
                Z = Library.Order.Window + 7
            })

            local Line = Stroke(Frame)
            Line.Instance.Transparency = 0.6
            Library:StampResting(Line.Instance, "Transparency", 0.6)

            local Reach = math.min(CardWide - 10, CardTall - 24)

            local Picture = MakeImage({
                Parent = Frame.Instance,
                Pos = UDim2.new(0.5, 0, 0.5, -7),
                Size = UDim2.fromOffset(Reach, Reach),
                Anchor = Vector2.new(0.5, 0.5),
                Z = Library.Order.Window + 8
            })

            if SkinParams.ImageColor then
                Picture.Instance.ImageColor3 = SkinParams.ImageColor
            end

            local Label = MakeText({
                Parent = Frame.Instance,
                Pos = UDim2.new(0, 4, 1, -16),
                Size = UDim2.new(1, -8, 0, 13),
                Text = Name,
                TextSize = 12,
                Color = "InactiveText",
                Align = Enum.TextXAlignment.Center,
                Truncate = true,
                Z = Library.Order.Window + 8
            })

            local Hit = MakeButton({
                Parent = Frame.Instance,
                Size = UDim2.fromScale(1, 1),
                Z = Library.Order.Window + 9
            })

            local Card = {
                Name = Name,
                Lower = Name:lower(),
                Source = SkinParams.Image,
                Frame = Frame,
                Label = Label,
                Line = Line,
                Image = Picture,
                Loaded = false,
                Shown = false
            }

            Hit:Hover(function()
                if Section.Value ~= Name then
                    Library:Tween({
                        BackgroundTransparency = 0.6
                    }, FadeInfo, Frame.Instance)
                end
            end, function()
                if Section.Value ~= Name then
                    Library:Tween({
                        BackgroundTransparency = 1
                    }, FadeInfo, Frame.Instance)
                end
            end)

            Hit:Connect("MouseButton1Down", function()
                Section.Value = Name
                PaintCards()

                if Params.Callback then
                    Library:SafeCall(Params.Callback, Name)
                end
            end)

            table.insert(Cards, Card)

            if SkinParams.Default then
                Section.Value = Name
            end

            PaintCard(Card)
        end

        local function Drain()
            if Building then
                return
            end

            Building = true

            Library:Thread(function()
                while #Pending > 0 do
                    for _ = 1, 24 do
                        local Next = table.remove(Pending, 1)

                        if not Next then
                            break
                        end

                        Build(Next)
                    end

                    Section:Relayout()

                    if #Pending > 0 then
                        task.wait()
                    end
                end

                Building = false
                Section:Relayout()
            end)
        end

        function Section:Skin(SkinParams)
            table.insert(Pending, SkinParams or {})
            Drain()
        end

        function Section:Clear()
            table.clear(Pending)

            for Index = 1, #Cards do
                Cards[Index].Frame.Instance:Destroy()
            end

            table.clear(Cards)
            Section.Value = nil
            Grid.Instance.CanvasPosition = Vector2.new(0, 0)
            Grid.Instance.CanvasSize = UDim2.fromOffset(0, 0)
        end

        function Section:Snapshot()
            Section:Relayout()
            PaintCards()
        end

        function Section:SetSkin(Name)
            Section.Value = Name
            PaintCards()
        end
    end


    Section:Reflow()

    return Section
end

