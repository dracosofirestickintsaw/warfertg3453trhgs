        Z = Z + 1
    })

    local Countdown = MakeText({
        Parent = Card.Instance,
        Pos = UDim2.fromOffset(0, TitleY),
        Size = UDim2.fromOffset(30, TitleTall),
        Text = string.format("%.1fs", Duration),
        TextSize = 12,
        Color = "InactiveText",
        Align = Enum.TextXAlignment.Right,
        Z = Z + 1
    })

    local BodyLabel

    if Body ~= "" then
        BodyLabel = MakeText({
            Parent = Card.Instance,
            Pos = UDim2.fromOffset(26, 26),
            Size = UDim2.fromOffset(200, 16),
            Text = Body,
            TextSize = 13,
            Color = "InactiveText",
            Truncate = true,
            Z = Z + 1
        })
    end

    local Width = Library:TextWidth(TitleLabel.Instance) + 34

    if BodyLabel then
        Width = math.max(Width, Library:TextWidth(BodyLabel.Instance))
    end

    Width = math.clamp(math.floor(Width) + 40, 190, 360)

    local BarWidth = Width - 24
    local BarY = Height - 10

    Slot.Instance.Size = UDim2.fromOffset(Width, Height)
    Card.Instance.Size = UDim2.fromOffset(Width, Height)
    Card.Instance.Position = UDim2.fromOffset(Width + 40, 0)
    TitleLabel.Instance.Size = UDim2.fromOffset(Width - 70, TitleTall)
    Countdown.Instance.Position = UDim2.fromOffset(Width - 42, TitleY)

    if BodyLabel then
        BodyLabel.Instance.Size = UDim2.fromOffset(Width - 38, 16)
    end

    local Track = MakeFrame({
        Parent = Card.Instance,
        Pos = UDim2.fromOffset(12, BarY),
        Size = UDim2.fromOffset(BarWidth, 3),
        Color = "Outline",
        Transparency = 0.5,
        Round = 3,
        Clip = true,
        Z = Z + 1
    })

    local Timer = MakeFrame({
        Parent = Track.Instance,
        Size = UDim2.fromOffset(BarWidth, 3),
        Round = 3,
        Z = Z + 2
    })

    local TimerGradient = Gradient(Timer, Library:AccentSequence())

    table.insert(Library.ThemingStuff, {
        Item = TimerGradient.Instance,
        Properties = {
            Color = function()
                return Library:AccentSequence()
            end
        }
    })

    Library:FadeGroup(Card.Instance, true)

    Library:Tween({
        Position = UDim2.fromOffset(0, 0)
    }, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), Card.Instance)

    Library:Tween({
        Size = UDim2.fromOffset(0, 3)
    }, TweenInfo.new(Duration, Enum.EasingStyle.Linear), Timer.Instance)

    local Deadline = os.clock() + Duration
    local Ticker

    Ticker = Library:Connect(RunService.RenderStepped, function()
        if not Card.Instance.Parent then
            Ticker:Disconnect()
            return
        end

        local Left = math.max(0, Deadline - os.clock())
        Countdown.Instance.Text = string.format("%.1fs", Left)

        if Left <= 0 then
            Ticker:Disconnect()
        end
    end)

    task.delay(Duration, function()
        if not Card.Instance.Parent then
            return
        end

        Library:Tween({
            Position = UDim2.fromOffset(Width + 40, 0)
        }, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), Card.Instance)

        Library:FadeGroup(Card.Instance, false, function()
            Slot.Instance:Destroy()
        end)
    end)

    return Card
end

