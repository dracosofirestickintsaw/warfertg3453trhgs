    }

    local function Fit()
        local Reach = Library:TextWidth(Label.Instance) + 3
        local Width = math.max(66, Reach + 18)

        if Row.Instance.Size.X.Offset ~= Width then
            Row.Instance.Size = UDim2.fromOffset(Width, 22)
            Label.Instance.Size = UDim2.fromOffset(Width - 9, 22)
            RefreshHotkeyPanel()
        end
    end

    Library:Connect(Label.Instance:GetPropertyChangedSignal("TextBounds"), Fit)

    Data.Update = function(Key, Visible)
        local Wanted = Key and Visible and true or false
        local Fresh

        if Wanted then
            Label.Instance.Text = Data.Name .. " - " .. Library:KeyLabel(Key)

            Library:Remeasure(Fit)

            if not Row.Shown then
                Row.Shown = true
                Fresh = Row
                Library:FadeGroup(Row.Instance, true)
            end
        elseif Row.Shown then
            Row.Shown = false
            Library:FadeGroup(Row.Instance, false)
        end

        RefreshHotkeyPanel(Fresh)
    end

    Data.SetActive = function(State)
        Library:Tween({
            TextColor3 = State and Library.Theme.Text or Library.Theme.InactiveText
        }, HotkeySlide, Label.Instance)
    end

    Data.Rename = function(NewName)
        Data.Name = NewName
    end

