    local function UpdateScale()
        local Viewport = workspace.CurrentCamera.ViewportSize
        local FitX = (Viewport.X * 0.94) / WindowWidth
        local FitY = (Viewport.Y * 0.9) / WindowHeight
        local Scale = math.clamp(math.min(FitX, FitY), 0.45, 1)

        if IsMobile then
            Scale = math.clamp(Scale * MobileScale, 0.3, 1)
        end

        Window.Scale = Scale
        Scaler.Instance.Scale = Scale

        local MaxX = math.max(0, Viewport.X - WindowWidth * Scale)
        local MaxY = math.max(0, Viewport.Y - WindowHeight * Scale)

        Shell.Instance.Position = UDim2.fromOffset(
            math.clamp(Shell.Instance.Position.X.Offset, 0, MaxX),
            math.clamp(Shell.Instance.Position.Y.Offset, 0, MaxY)
        )
    end

    local function Center()
        local Viewport = workspace.CurrentCamera.ViewportSize

        if Viewport.X < 2 or Viewport.Y < 2 then
            return false
        end

        local Scale = Scaler.Instance.Scale
        local Wide = WindowWidth * Scale
        local Tall = WindowHeight * Scale

        Shell.Instance.Position = UDim2.fromOffset(
            math.floor(math.max(0, (Viewport.X - Wide) / 2)),
            math.floor(math.max(0, (Viewport.Y - Tall) / 2))
        )

        return true
    end

    Window.Center = Center
    Window.UpdateScale = UpdateScale
    UpdateScale()
    Center()

