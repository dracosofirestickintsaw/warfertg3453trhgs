        Z = Library.Order.Window + 8
    })

    Element.NameLabel = Text
    Element.Track = Track
    Element.Fill = Fill
    Element.Knob = Knob
    Element.ValueBox = ValueBox

    local Shown = 0
    local Wanted = 0
    local Smoothing = Params.Smoothing or 14

    local function Draw()
        local Width = math.floor(Shown)
        local KnobX = 10 + math.clamp(Width - 5, -5, InnerWidth - 5)

        Fill.Instance.Size = UDim2.fromOffset(Width, 8)
        Knob.Instance.Position = UDim2.fromOffset(KnobX, 25)
    end

    local function Paint(Instant)
        local Alpha = (Element.Value - Min) / math.max(1e-6, Max - Min)

        Wanted = InnerWidth * Alpha
        ValueBox.Instance.Text = tostring(Element.Value) .. Suffix
        Library:Remeasure(SizeBox)

        if Instant then
            Shown = Wanted
            Draw()
        end
    end

    Library:Connect(RunService.RenderStepped, function(Delta)
        if math.abs(Wanted - Shown) < 0.05 then
            if Shown ~= Wanted then
                Shown = Wanted
                Draw()
            end

            return
        end

        Shown = Shown + (Wanted - Shown) * math.clamp(Delta * Smoothing, 0, 1)
        Draw()
    end)

    function Element:Set(Value, Silent)
        Element.Value = Library:Round(math.clamp(Value, Min, Max), Float)
        Library.Flags[Flag] = Element.Value
        Paint(Silent)

        if not Silent and Params.Callback then
            Library:SafeCall(Params.Callback, Element.Value)
        end
    end

    local Dragging = false

    local function Apply(Input)
        local Origin = Track.Instance.AbsolutePosition.X
        local Width = Track.Instance.AbsoluteSize.X
        local Alpha = math.clamp((Input.Position.X - Origin) / math.max(1, Width), 0, 1)

        Element:Set(Min + (Max - Min) * Alpha)
    end

    Hit:Connect("InputBegan", function(Input)
        if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        Dragging = true
        Apply(Input)
    end)

    Library:Connect(UserInputService.InputChanged, function(Input)
        if not Dragging then
            return
        end

        if Input.UserInputType ~= Enum.UserInputType.MouseMovement and Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        Apply(Input)
    end)

    Library:Connect(UserInputService.InputEnded, function(Input)
        if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if Dragging then
            Dragging = false
        end
    end)

    Hit:HoverGradient(Track)

    ValueBox:Connect("FocusLost", function()
        local Typed = tonumber(ValueBox.Instance.Text:match("%-?%d+%.?%d*"))

        if Typed then
            Element:Set(Typed)
        else
            Paint(true)
        end
    end)

    Library.SetFlags[Flag] = function(Value)
        Element:Set(Value)
    end

    Element:Set(Element.Value, true)
    Section:Reflow()

    return Element
end

function Library:Reveal(Params)
    Params = Params or {}

    local Owner = self
    local Host = Owner.Section
    local Root = Host

    while Root and rawget(Root, "Host") do
        Root = rawget(Root, "Host")
    end

    local Wide = Host.Width or (Root and Root.Width) or SectionWidth
    local Tab = Host.Tab or (Root and Root.Tab)
    local Label = (Root and Root.NameText) or (Host and Host.NameText) or "Section"

    local Box = Host:NewRow(0, nil)

    Box.Row.Instance.ClipsDescendants = true
    Box.Row.Instance.Visible = false

    local Scope = setmetatable({
        Host = Host,
        Tab = Tab,
        Width = Wide,
        Elements = {},
        Box = Box,
        Owner = Owner,
        Open = false,
        Shown = 0,
        Wanted = 0,
        Full = 0
    }, Library)

    function Scope:NewRow(Height, Name, Kind)
        local Row = MakeFrame({
            Parent = Box.Row.Instance,
            Size = UDim2.fromOffset(Wide, Height),
            Transparency = 1,
            Z = Library.Order.Window + 4
        })

        local Element = setmetatable({
            Row = Row,
            Height = Height,
            Section = Scope,
            Slot = Wide - 12,
            Adorn = {},
            Name = Name
        }, Library)

        function Element:LayoutAdorns()
            local Right = Element.Slot

            for Index = 1, #Element.Adorn do
                local Item = Element.Adorn[Index]

                Right = Right - Item.Width
                Item.Place(Right)
                Right = Right - 5
            end
        end

        function Element:AddAdorn(Item)
            table.insert(Element.Adorn, Item)
            Element:LayoutAdorns()

            return Item
        end

        table.insert(Scope.Elements, Element)

        if Name then
            RegisterSearch({
                Kind = Kind or "Element",
                Name = Name,
                Path = tostring(Tab and Tab.Name or "Tab") .. " / " .. tostring(Label),
                Tab = Tab,
                Section = Root or Host,
                Element = Element
            })
        end

        return Element
    end

    function Scope:Measure()
        local Y = 0

        for Position = 1, #Scope.Elements do
            local Item = Scope.Elements[Position]

            if not Item.Row.Instance.Visible then
                continue
            end

            Item.Row.Instance.Position = UDim2.fromOffset(0, Y)
            Y = Y + Item.Height
        end

        Scope.Full = Y
        return Y
    end

    function Scope:Apply(Tall)
        Box.Height = Tall
        Box.Row.Instance.Size = UDim2.fromOffset(Wide, Tall)
        Host:Reflow()
    end

    function Scope:Reflow()
        local Y = Scope:Measure()

        if Scope.Open then
            Scope.Wanted = Y
        end

        Host:Reflow()
    end

    function Scope:Snap(State)
        Scope.Open = State and true or false
        Scope:Measure()

        Scope.Wanted = Scope.Open and Scope.Full or 0
        Scope.Shown = Scope.Wanted

        Box.Row.Instance.Visible = Scope.Open
        Scope:Apply(Scope.Wanted)
    end

    function Scope:SetOpen(State)
        State = State and true or false

        if Scope.Open == State then
            return
        end

        Scope.Open = State
        Scope:Measure()

        if State then
            Scope.Wanted = Scope.Full
            Box.Row.Instance.Visible = true
            Library:HideForBoot(Box.Row.Instance)
            Library:FadeGroup(Box.Row.Instance, true)
        else
            Scope.Wanted = 0
            Library:FadeGroup(Box.Row.Instance, false)
        end
    end

    Library:Connect(RunService.RenderStepped, function(Delta)
        if Scope.Shown == Scope.Wanted then
            return
        end

        local Step = math.clamp(Delta * 16, 0, 1)
        Scope.Shown = Scope.Shown + (Scope.Wanted - Scope.Shown) * Step

        if math.abs(Scope.Wanted - Scope.Shown) < 0.6 then
            Scope.Shown = Scope.Wanted
        end

        Scope:Apply(math.floor(Scope.Shown + 0.5))

        if Scope.Shown == 0 and not Scope.Open then
            Box.Row.Instance.Visible = false
            Host:Reflow()
        end
    end)

    local Test = Params.When

    local function Wanted()
        local Value = Owner.Value

        if Test then
            return Test(Value) and true or false
        end

        if type(Value) == "table" then
            return #Value > 0
        end

        return Value ~= nil and Value ~= false
    end

    local BaseSet = Owner.Set

    if BaseSet then
        Owner.Set = function(This, Value, Silent)
            BaseSet(This, Value, Silent)
            Scope:SetOpen(Wanted())
        end
    end

    Library:Thread(function()
        task.wait()
        Scope:Snap(Wanted())
    end)

    Owner.RevealBox = Scope
    return Scope
end


local function AttachPopup(Holder, Anchor)
    local Popup = {
        Holder = Holder,
        Anchor = Anchor,
        IsOpen = false,
        Busy = false,
        OpenedAt = 0,
        ConsumedInput = nil
    }

    Holder.Instance.Parent = Storage
    Holder.Instance.Visible = false

    local function Consume(Input)
        if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        Popup.ConsumedInput = Input
    end

    local function Watch(Object)
        if Object:IsA("GuiObject") then
            Library:Connect(Object.InputBegan, Consume)
        end
    end

    Watch(Holder.Instance)

    for _, Object in next, Holder.Instance:GetDescendants() do
        Watch(Object)
    end

    Library:Connect(Holder.Instance.DescendantAdded, Watch)

    local Scaler = Library:Create("UIScale", {
        Parent = Holder.Instance,
        Scale = 1
    })

    local function Place()
        local Scale = 1

        if Library.Window and Library.Window.Scaler then
            Scale = Library.Window.Scaler.Instance.Scale
        end

        Scaler.Instance.Scale = Scale

        local Inset = GuiService:GetGuiInset().Y
        local Origin = Anchor.Instance.AbsolutePosition
        local Size = Anchor.Instance.AbsoluteSize
        local Viewport = workspace.CurrentCamera.ViewportSize

        local Width = Holder.Instance.Size.X.Offset * Scale
        local Height = Holder.Instance.Size.Y.Offset * Scale

        local Top = Origin.Y + Inset
        local X = Origin.X
        local Y = Top + Size.Y + 9

        if Y + Height > Viewport.Y - 8 and Top - Height - 9 >= 8 then
            Y = Top - Height - 9
        end

        X = math.clamp(X, 6, math.max(6, Viewport.X - Width - 6))
        Y = math.clamp(Y, 6, math.max(6, Viewport.Y - Height - 6))

        return X, Y
    end

    function Popup:SetOpen(State)
        State = State and true or false

        if Popup.IsOpen == State then
            return
        end

        if State and Popup.Busy then
            return
        end

        Popup.IsOpen = State

        if State then
            for Other in next, Library.OpenFrames do
                if Other ~= Popup then
                    Other:SetOpen(false)
                end
            end

            Library.OpenFrames[Popup] = Popup
            Popup.Busy = true
            Popup.OpenedAt = os.clock()

            Holder.Instance.Parent = Root

            local X, Y = Place()
            Holder.Instance.Position = UDim2.fromOffset(X, Y - 8)
            Holder.Instance.Visible = true

            Library:Tween({
                Position = UDim2.fromOffset(X, Y)
            }, nil, Holder.Instance)

            Library:FadeGroup(Holder.Instance, true, function()
                Popup.Busy = false
            end)

            if Popup.OnState then
                Library:SafeCall(Popup.OnState, true)
            end
        else
            Library.OpenFrames[Popup] = nil
            Popup.Busy = true

            local X = Holder.Instance.Position.X.Offset
            local Y = Holder.Instance.Position.Y.Offset

            Library:Tween({
                Position = UDim2.fromOffset(X, Y - 8)
            }, nil, Holder.Instance)

            Library:FadeGroup(Holder.Instance, false, function()
                if not Popup.IsOpen then
                    Holder.Instance.Parent = Storage
                end

                Popup.Busy = false
            end)

            if Popup.OnState then
                Library:SafeCall(Popup.OnState, false)
            end
        end
    end

    function Popup:Toggle()
        Popup:SetOpen(not Popup.IsOpen)
    end

    Library:Connect(UserInputService.InputBegan, function(Input)
        if not Popup.IsOpen then
            return
        end

        if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if os.clock() - Popup.OpenedAt < 0.05 then
            return
        end

        local Point = Library:InputPoint(Input)

        if Holder:HitPoint(Point) or Anchor:HitPoint(Point) then
            return
        end

        task.defer(function()
            if not Popup.IsOpen then
                return
            end

            if Popup.ConsumedInput == Input then
                return
            end

            Popup:SetOpen(false)
        end)
    end)

    return Popup
end

