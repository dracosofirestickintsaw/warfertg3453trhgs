local MouseNames = {
    [Enum.UserInputType.MouseButton1] = "MB1",
    [Enum.UserInputType.MouseButton2] = "MB2",
    [Enum.UserInputType.MouseButton3] = "MB3"
}

local KeyAliases = {
    MOUSE1 = Enum.UserInputType.MouseButton1,
    MOUSE2 = Enum.UserInputType.MouseButton2,
    MOUSE3 = Enum.UserInputType.MouseButton3
}

function Library:KeyLabel(Key)
    if not Key then
        return "NONE"
    end

    if MouseNames[Key] then
        return MouseNames[Key]
    end

    if KeyNames[Key] then
        return KeyNames[Key]
    end

    if typeof(Key) == "EnumItem" then
        local Name = Key.Name:upper()

        if #Name > 6 then
            Name = Name:sub(1, 6)
        end

        return Name
    end

    return tostring(Key):upper()
end

function Library:KeyFromString(Text)
    if not Text or Text == "NONE" then
        return nil
    end

    if KeyAliases[Text] then
        return KeyAliases[Text]
    end

    for Key, Name in next, MouseNames do
        if Name == Text then
            return Key
        end
    end

    for Key, Name in next, KeyNames do
        if Name == Text then
            return Key
        end
    end

    for _, Key in next, Enum.KeyCode:GetEnumItems() do
        if Key.Name:upper() == Text then
            return Key
        end
    end

    for _, Key in next, Enum.KeyCode:GetEnumItems() do
        if Key.Name:upper():sub(1, 6) == Text then
            return Key
        end
    end

    return nil
end

function Library:KeyDown(Key)
    if not Key then
        return false
    end

    if MouseNames[Key] then
        return UserInputService:IsMouseButtonPressed(Key)
    end

    return UserInputService:IsKeyDown(Key)
end


