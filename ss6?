    function Window:Select(Tab)
        if Window.Current == Tab then
            return
        end

        local Previous = Window.Current
        Window.Current = Tab
        Window.ShowToken = Window.ShowToken + 1
        local Token = Window.ShowToken

        for _, Other in next, Window.Tabs do
            local Selected = Other == Tab

            Library:Tween({
                BackgroundTransparency = Selected and 0 or 1
            }, nil, Other.Row.Instance)

            Library:Tween({
                Transparency = Selected and 0.4 or 1
            }, nil, Other.RowStroke.Instance)

            Library:Tween({
                TextColor3 = Selected and Library.Theme.Text or Library.Theme.InactiveText
            }, nil, Other.NameLabel.Instance)

            Library:Tween({
                ImageColor3 = Selected and Library.Theme.Text or Library.Theme.InactiveText
            }, nil, Other.Icon.Instance)

            Library:StampResting(Other.Row.Instance, "BackgroundTransparency", Selected and 0 or 1)
            Library:StampResting(Other.RowStroke.Instance, "Transparency", Selected and 0.4 or 1)
        end

        if Previous then
            for Index = 1, 3 do
                local Page = Previous.Pages[Index]

                if Previous.WideMode and Index < 3 then
                    continue
                end

                Library:Tween({
                    Position = UDim2.fromOffset(0, -14)
                }, nil, Page.Instance)

                Library:FadeGroup(Page.Instance, false, function()
                    if Window.ShowToken ~= Token then
                        return
                    end

                    Page.Instance.Position = UDim2.fromOffset(0, 0)
                end)
            end
        end

        Wide.Instance.Visible = Tab.WideMode
        Left.Instance.Visible = not Tab.WideMode
        Right.Instance.Visible = not Tab.WideMode

        for Index = 1, 3 do
            local Page = Tab.Pages[Index]
            local Column = Window.Columns[Index]

            if Tab.WideMode and Index < 3 then
                Page.Instance.Visible = true
                continue
            end

            Page.Instance.Position = UDim2.fromOffset(0, 14)
            Page.Instance.Visible = true

            Library:Tween({
                Position = UDim2.fromOffset(0, 0)
            }, nil, Page.Instance)

            Library:FadeGroup(Page.Instance, true)

            Column.Instance.CanvasPosition = Vector2.new(0, 0)
            Column.Instance.CanvasSize = UDim2.fromOffset(0, Tab.Heights[Index] + 12)
        end
    end

    function Window:GoWide(Tab)
        if Tab.WideMode then
