function Library:GetConfig()
    local Config = {}

    for Index, Value in next, Library.Flags do
        if type(Value) == "table" and Value.Key then
            Config[Index] = {
                Key = Value.Key,
                Mode = Value.Mode,
                Shown = Value.Shown
            }
        elseif type(Value) == "table" and Value.HexValue then
            Config[Index] = {
                Color = Value.HexValue,
                Alpha = Value.Alpha
            }
        elseif type(Value) ~= "userdata" then
            Config[Index] = Value
        end
    end

    Config.__Theme = {
        Name = Library.ThemeName
    }

    for Key, Color in next, Library.Theme do
        Config.__Theme[Key] = Color:ToHex()
    end

    return HttpService:JSONEncode(Config)
end

function Library:LoadConfig(Raw)
    local Success, Decoded = pcall(HttpService.JSONDecode, HttpService, Raw)

    if not Success then
        return false, Decoded
    end

    if Decoded.__Theme then
        for Key, Value in next, Decoded.__Theme do
            if Key ~= "Name" and Library.Theme[Key] then
                pcall(function()
                    Library.Theme[Key] = Color3.fromHex(Value)
                end)
            end
        end

        Library.ThemeName = Decoded.__Theme.Name or Library.ThemeName
        Library:RefreshTheme()
        Decoded.__Theme = nil
    end

    for Index, Value in next, Decoded do
        local Setter = Library.SetFlags[Index]

        if not Setter then
            continue
        end

        if type(Value) == "table" and Value.Color then
            Library:SafeCall(Setter, Value.Color, Value.Alpha)
        else
            Library:SafeCall(Setter, Value)
        end
    end

    return true
end

function Library:ConfigList()
    local List = {}
    local Files = listfiles(Library.Directory .. Library.Folders.Configs)

    for _, Path in next, Files do
        if Path:sub(-5) ~= ".json" then
            continue
        end

        local Name = Path:match("([^/\\]+)%.json$")

        if Name then
            table.insert(List, Name)
        end
    end

    table.sort(List)
    return List
end

function Library:SaveConfig(Name)
    if not Name or Name:gsub("%s", "") == "" then
        return false
    end

    writefile(Library.Directory .. Library.Folders.Configs .. "/" .. Name .. ".json", Library:GetConfig())
    return true
end

function Library:DeleteConfig(Name)
    local Path = Library.Directory .. Library.Folders.Configs .. "/" .. Name .. ".json"

    if isfile(Path) then
        delfile(Path)
        return true
    end

    return false
end

function Library:Exit()
    if Library.Unloaded then
        return
    end

    Library.Unloaded = true

    for _, Connection in next, Library.Connections do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    for _, Thread in next, Library.Threads do
        pcall(coroutine.close, Thread)
    end

    if Library.Holder then
        Library.Holder.Instance:Destroy()
    end

    if Library.UnusedHolder then
        Library.UnusedHolder.Instance:Destroy()
    end

    getgenv().Blossom = nil
end


local function Pose(Rig)
    local Anchor = Rig.PrimaryPart or Rig:FindFirstChild("HumanoidRootPart")

    if not Anchor then
        return
    end

    local Joints = {}

    for _, Item in next, Rig:GetDescendants() do
        if Item:IsA("Motor6D") and Item.Part0 and Item.Part1 then
            local List = Joints[Item.Part0]

            if not List then
                List = {}
                Joints[Item.Part0] = List
            end

            table.insert(List, Item)
        end
    end

    local Seen = {}
    local Queue = { Anchor }
    local Index = 1

    Seen[Anchor] = true

    while Index <= #Queue do
        local Part = Queue[Index]
        local List = Joints[Part]

        Index = Index + 1

        if List then
            for _, Joint in next, List do
                local Next = Joint.Part1

                if not Seen[Next] then
                    Seen[Next] = true
                    Next.CFrame = Part.CFrame * Joint.C0 * Joint.C1:Inverse()

                    table.insert(Queue, Next)
                end
            end
        end
    end
end

local function Fasten(Rig)
    local Points = {}

    for _, Item in next, Rig:GetDescendants() do
        if Item:IsA("Attachment") and Item.Parent and Item.Parent.Name ~= "Handle" then
            Points[Item.Name] = Item
        end
    end

    for _, Item in next, Rig:GetChildren() do
        if not Item:IsA("Accessory") then
            continue
        end

        local Handle = Item:FindFirstChild("Handle")

        if not Handle then
            continue
        end

        for _, Hook in next, Handle:GetChildren() do
            if not Hook:IsA("Attachment") then
                continue
            end

            local Target = Points[Hook.Name]

            if Target then
                Handle.CFrame = Target.WorldCFrame * Hook.CFrame:Inverse()
                break
            end
        end
    end
end

function Library:Viewport(Params)
    Params = Params or {}

    local Section = self
    local Tall = Params.Height or 230
    local Element = Section:NewRow(Tall + 10, Params.Name, "Viewport")

    Element.Player = Params.Player or LocalPlayer
    Element.Rotation = math.rad(Params.Rotation or 0)
    Element.Spin = Params.Spin or false
    Element.Speed = Params.Speed or 0.6

    local Box = MakeFrame({
        Parent = Element.Row.Instance,
        Pos = UDim2.fromOffset(10, 4),
        Size = UDim2.fromOffset(InnerWidth, Tall),
        Color = "Tab",
        Round = 4,
        Stroke = true,
        Clip = true,
        Z = Library.Order.Window + 5
    })

    local Viewport = Library:Create("ViewportFrame", {
        Parent = Box.Instance,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Ambient = Params.Ambient or Color3.fromRGB(190, 190, 190),
        LightColor = Params.LightColor or Color3.fromRGB(255, 255, 255),
        LightDirection = Vector3.new(-0.4, -1, -0.6),
        ZIndex = Library.Order.Window + 6
    })

    local World = Library:Create("WorldModel", {
        Parent = Viewport.Instance
    })

    local Lens = Library:Create("Camera", {
        Parent = Viewport.Instance,
        FieldOfView = Params.FieldOfView or 30
    })

    Viewport.Instance.CurrentCamera = Lens.Instance

    Element.Box = Box
    Element.ViewportFrame = Viewport
    Element.Camera = Lens
    Element.Model = nil

    function Element:Project(Point)
        local Rel = Lens.Instance.CFrame:PointToObjectSpace(Point)
        local Depth = -Rel.Z

        if Depth <= 0.01 then
            return Vector2.new(0, 0), false
        end

        local Tan = math.tan(math.rad(Lens.Instance.FieldOfView) * 0.5)
        local Aspect = InnerWidth / Tall

        return Vector2.new(
            InnerWidth * 0.5 * (1 + Rel.X / (Depth * Tan * Aspect)),
            Tall * 0.5 * (1 - Rel.Y / (Depth * Tan))
        ), true
    end

    local Model
    local Distance = 6
    local Focus = 3

    local function Aim()
        if not Model or not Model.Parent then
            return
        end

        Model:PivotTo(CFrame.Angles(0, Element.Rotation, 0))

        Lens.Instance.CFrame = CFrame.lookAt(
            Vector3.new(0, Focus, -Distance),
            Vector3.new(0, Focus, 0)
        )
    end

    local Attempt = 0
    local Loading = false
    local Placeholder = false
    local NextCheck = 0

    local function Build(Person)
        local Built

        pcall(function()
            Built = Players:CreateHumanoidModelFromUserId(Person.UserId)
        end)

        if not Built then
            pcall(function()
                local Look = Players:GetHumanoidDescriptionFromUserId(Person.UserId)

                if Look then
                    Built = Players:CreateHumanoidModelFromDescription(Look, Enum.HumanoidRigType.R15)
                end
            end)
        end

        if not Built then
            pcall(function()
                local Live = Person.Character

                if Live then
                    Live.Archivable = true
                    Built = Live:Clone()
                end
            end)
        end

        return Built
    end

    local function Blank()
        local Built

        pcall(function()
            Built = Players:CreateHumanoidModelFromDescription(
                Instance.new("HumanoidDescription"),
                Enum.HumanoidRigType.R15
            )
        end)

        return Built
    end

    local function Mount(Built, Fake)
        for _, Piece in next, Built:GetDescendants() do
            if Piece:IsA("Script") or Piece:IsA("LocalScript") then
                Piece:Destroy()
            elseif Piece:IsA("Humanoid") then
                Piece.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            end
        end

        if Model then
            Model:Destroy()
        end

        Built.Parent = World.Instance
        Model = Built
        Element.Model = Built
        Placeholder = Fake == true

        local Rig = Built:FindFirstChildOfClass("Humanoid")

        if Rig then
            pcall(function()
                Rig:BuildRigFromAttachments()
            end)
        end

        Pose(Built)
        Fasten(Built)

        for _, Piece in next, Built:GetDescendants() do
            if Piece:IsA("BasePart") then
                Piece.Anchored = true
                Piece.CanCollide = false
            end
        end

        Built:PivotTo(CFrame.new())

        local Bounds, Span = Built:GetBoundingBox()
        local Aspect = InnerWidth / Tall
        local Half = math.tan(math.rad(Lens.Instance.FieldOfView) * 0.5)

        Focus = Bounds.Position.Y
        Distance = math.max(
            (Span.Y * 0.5) / Half,
            (Span.X * 0.5) / (Half * Aspect)
        ) * 1.45

        Aim()
    end

    local function Healthy()
        if not Model or not Model.Parent then
            return false
        end

        local Count = 0

        for _, Piece in next, Model:GetDescendants() do
            if Piece:IsA("BasePart") then
                Count = Count + 1

                if Count >= 6 then
                    return true
                end
            end
        end

        return false
    end

    Element.Healthy = Healthy

    local function Place(Built, Fake)
        local Ok = pcall(Mount, Built, Fake)

        if not Ok then
            pcall(function()
                Built:Destroy()
            end)

            return false
        end

        return Healthy()
    end

    local function Load(Person)
        Element.Player = Person or Element.Player
        Attempt = Attempt + 1
        Loading = true

        local Mine = Attempt

        Library:Thread(function()
            local Done = false

            for Round = 1, 6 do
                if Mine ~= Attempt then
                    return
                end

                local Built = Build(Element.Player)

                if Built then
                    if Mine ~= Attempt then
                        pcall(function()
                            Built:Destroy()
                        end)

                        return
                    end

                    if Place(Built, false) then
                        Done = true
                        break
                    end
                end

                task.wait(Round * 0.6)
            end

            if Mine ~= Attempt then
                return
            end

            if not Done and not Healthy() then
                local Fallback = Blank()

                if Fallback then
                    Place(Fallback, true)
                end
            end

            Loading = false
            NextCheck = os.clock() + (Done and 0 or 5)
        end)
    end

    local Dragging = false
    local Settled = false
    local LastX = 0
    local StartX = 0
    local StartY = 0

    if Params.Rotate ~= false then
        local Hit = MakeButton({
            Parent = Box.Instance,
            Size = UDim2.fromScale(1, 1),
            Z = Library.Order.Window + 7
        })

        Hit:Connect("InputBegan", function(Input)
            if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            Dragging = true
            Settled = Input.UserInputType ~= Enum.UserInputType.Touch
            LastX = Input.Position.X
            StartX = Input.Position.X
            StartY = Input.Position.Y
        end)

        Library:Connect(UserInputService.InputChanged, function(Input)
            if not Dragging then
                return
            end

            if Input.UserInputType ~= Enum.UserInputType.MouseMovement and Input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            if not Settled then
                local MovedX = math.abs(Input.Position.X - StartX)
                local MovedY = math.abs(Input.Position.Y - StartY)

                if math.max(MovedX, MovedY) < 6 then
                    return
                end

                if MovedY > MovedX then
                    Dragging = false
                    return
                end

                Settled = true
                LastX = Input.Position.X
            end

            Element.Rotation = Element.Rotation - (Input.Position.X - LastX) * 0.012
            LastX = Input.Position.X

            Aim()
        end)

        Library:Connect(UserInputService.InputEnded, function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                Dragging = false
            end
        end)

        Element.Hit = Hit
    end

    Library:Connect(RunService.RenderStepped, function(Delta)
        if not Element.Spin or Dragging or not Model then
            return
        end

        Element.Rotation = Element.Rotation + Delta * Element.Speed
        Aim()
    end)

    Library:Connect(RunService.Heartbeat, function()
        if Loading then
            return
        end

        local Missing = not Healthy()

        if not Missing and not Placeholder then
            return
        end

        local Now = os.clock()

        if Now < NextCheck then
            return
        end

        NextCheck = Now + (Missing and 2 or 8)
        Load(Element.Player)
    end)

    Library:Connect(LocalPlayer.CharacterAdded, function()
        if Element.Player ~= LocalPlayer then
            return
        end

        task.wait(1)
        Load(LocalPlayer)
    end)

    function Element:SetPlayer(Person)
        Load(Person)
    end

    function Element:SetSpin(State)
        Element.Spin = State and true or false

        if Element.Spin then
            Aim()
        end
    end

    function Element:SetRotation(Degrees)
        Element.Rotation = math.rad(Degrees or 0)
        Aim()
    end

    function Element:Refresh()
        Load(Element.Player)
    end

    Load(Element.Player)
    Section:Reflow()

    return Element
end

