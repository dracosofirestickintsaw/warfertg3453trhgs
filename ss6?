            })

            local LineGradient = Gradient(Line, Library:AccentSequence())

            table.insert(Library.ThemingStuff, {
                Item = LineGradient.Instance,
                Properties = {
                    Color = function()
                        return Library:AccentSequence()
                    end
                }
            })

            local Hit = MakeButton({
                Parent = Frame.Instance,
                Size = UDim2.fromOffset(InnerWidth, 24),
                Z = Library.Order.Window + 9
            })

            Hit:Hover(function()
                if Element.Value ~= Item then
                    Library:Tween({ BackgroundTransparency = 0.6 }, nil, Frame.Instance)
                end
            end, function()
                if Element.Value ~= Item then
                    Library:Tween({ BackgroundTransparency = 1 }, nil, Frame.Instance)
                end
            end)

            Hit:Connect("MouseButton1Down", function()
                Element.Value = Item
                Paint()

                if Params.Callback then
                    Library:SafeCall(Params.Callback, Item)
                end
            end)

            table.insert(Built, {
                Item = Item,
                Frame = Frame,
                Label = Label,
                Line = Line
            })

            Y = Y + 24
        end

        Scroll.Instance.CanvasSize = UDim2.fromOffset(0, Y)

        if Element.Value and not table.find(Element.Items, Element.Value) then
            Element.Value = nil
        end

        Paint()
    end

    function Element:Set(Value)
        Element.Value = Value
        Paint()
    end

    Element:Refresh(Element.Items)
    Section:Reflow()

    return Element
end

