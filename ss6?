function Library:SafeCall(Function, ...)
    if type(Function) ~= "function" then
        return false
    end

    local Success, Result = pcall(Function, ...)

    if not Success then
        warn("[Blossom] " .. tostring(Result))
    end

    return Success, Result
end

function Library:Round(Number, Float)
    local Multiplier = 1 / (Float or 1)
    return math.round(Number * Multiplier) / Multiplier
end

function Library:Thread(Function)
    local NewThread = coroutine.create(Function)

    coroutine.wrap(function()
        coroutine.resume(NewThread)
    end)()

    table.insert(Library.Threads, NewThread)
    return NewThread
end

function Library:Connect(Signal, Callback)
    local Connection

    if type(Signal) == "string" and self.Instance then
        local Event = self.Instance[Signal]

        if IsMobile and Signal == "MouseButton1Down" then
            Connection = self.Instance.InputBegan:Connect(function(Input)
                if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Callback(Input)
                end
            end)
        else
            Connection = Event:Connect(Callback)
        end
    else
        Connection = Signal:Connect(Callback)
    end

    table.insert(Library.Connections, Connection)
    return Connection
end

function Library:Create(Class, Properties)
    local Object = Instance.new(Class)

    for Property, Value in next, Properties do
        if Property == "Parent" then
            continue
        end

        Object[Property] = Value
    end

    Object.Name = "\0"

    if Properties.Parent then
        Object.Parent = Properties.Parent
    end

    if Library.SeedResting then
        Library:SeedResting(Object)
    end

    return setmetatable({
        Class = Class,
        Instance = Object
    }, Library)
end

local LiveTweens = setmetatable({}, { __mode = "k" })

function Library:CancelTween(Object, Property)
    local Store = LiveTweens[Object]

    if not Store then
        return
    end

    local Running = Store[Property]

    if Running then
        pcall(function()
            Running:Cancel()
        end)

        Store[Property] = nil
    end
end

function Library:Tween(Properties, Info, RawItem)
    local Object = RawItem or self.Instance

    if not Object or not Object.Parent then
        return
    end

    Info = Info or TweenInfo.new(Library.Animation.Time, Library.Animation.Style, Library.Animation.Direction)

    local NewTween = TweenService:Create(Object, Info, Properties)
    local Store = LiveTweens[Object]

    if not Store then
        Store = {}
        LiveTweens[Object] = Store
    end

    for Property in next, Properties do
        Library:CancelTween(Object, Property)
        Store[Property] = NewTween
    end

    NewTween:Play()

    return NewTween
end

function Library:AddToTheme(Properties)
    local Object = self.Instance

    local Data = {
        Item = Object,
        Properties = Properties
    }

    for Property, Value in next, Properties do
        if type(Value) == "string" then
            Object[Property] = Library.Theme[Value] or Object[Property]
        elseif type(Value) == "function" then
            Object[Property] = Value()
        end
    end

    table.insert(Library.ThemingStuff, Data)
    Library.ThemeMap[Object] = Data
    return self
end

function Library:RefreshTheme()
    for Index = #Library.ThemingStuff, 1, -1 do
        local Data = Library.ThemingStuff[Index]

        if not Data.Item or not Data.Item.Parent then
            table.remove(Library.ThemingStuff, Index)
            continue
        end

        for Property, Value in next, Data.Properties do
            if type(Value) == "string" then
                local Color = Library.Theme[Value]

                if Color then
                    Data.Item[Property] = Color
                end
            elseif type(Value) == "function" then
                Data.Item[Property] = Value()
            end
        end
    end
end

function Library:ChangeTheme(Key, Color)
    Library.Theme[Key] = Color
    Library:RefreshTheme()
end

function Library:ApplyTheme(Name)
    local Preset = Themes[Name]

    if not Preset then
        return
    end

    Library.ThemeName = Name

    for Key, Color in next, Preset do
        Library.Theme[Key] = Color
    end

    Library:RefreshTheme()

    if Library.OnThemeApplied then
        Library:SafeCall(Library.OnThemeApplied, Name)
    end
end


local FadeCache = {}

function Library:FadeTargets(Object)
    local Class = Object.ClassName
    local Hit = FadeCache[Class]

    if Hit ~= nil then
        if Hit == false then
            return nil
        end

        return Hit
    end

    local Found

    if Object:IsA("ViewportFrame") then
        Found = { "BackgroundTransparency", "ImageTransparency" }
    elseif Object:IsA("ScrollingFrame") then
        Found = { "BackgroundTransparency", "ScrollBarImageTransparency" }
    elseif Object:IsA("Frame") or Object:IsA("CanvasGroup") then
        Found = { "BackgroundTransparency" }
    elseif Object:IsA("TextLabel") or Object:IsA("TextButton") or Object:IsA("TextBox") then
        Found = { "BackgroundTransparency", "TextTransparency" }
    elseif Object:IsA("ImageLabel") or Object:IsA("ImageButton") then
        Found = { "BackgroundTransparency", "ImageTransparency" }
    elseif Object:IsA("UIStroke") or Object:IsA("UIShadow") then
        Found = { "Transparency" }
    end

    FadeCache[Class] = Found or false
    return Found
end

local function CollectFade(Object, Out)
    for _, Child in next, Object:GetChildren() do
        if Child:IsA("GuiObject") and not Child.Visible then
            continue
        end

        table.insert(Out, Child)
        CollectFade(Child, Out)
    end

    return Out
end

Library.CollectFade = CollectFade

local RestingValues = {}

function Library:StampResting(Object, Property, Value)
    local Store = RestingValues[Object]

    if not Store then
        Store = {}
        RestingValues[Object] = Store
    end

    Store[Property] = Value
end

function Library:GetResting(Object, Property)
    local Store = RestingValues[Object]

    if Store and Store[Property] ~= nil then
        return Store[Property]
    end

    return Object[Property]
end

function Library:SeedResting(Object)
    local Targets = Library:FadeTargets(Object)

    if not Targets then
        return
    end

    for _, Property in next, Targets do
        Library:StampResting(Object, Property, Object[Property])
    end
end

function Library:SetRest(Object, Property, Value)
    Object[Property] = Value
    Library:StampResting(Object, Property, Value)
end

local ActiveFades = setmetatable({}, { __mode = "k" })

function Library:FadeGroup(Target, Visible, Callback, Info)
    local Token = (ActiveFades[Target] or 0) + 1
    ActiveFades[Target] = Token

    if Visible then
        Target.Visible = true
    end

    local Items = CollectFade(Target, { Target })

    Info = Info or TweenInfo.new(Library.Animation.Time, Library.Animation.Style, Library.Animation.Direction)

    local Longest

    for _, Object in next, Items do
        local Targets = Library:FadeTargets(Object)

        if not Targets then
            continue
        end

        for _, Property in next, Targets do
            local Resting = Library:GetResting(Object, Property)
            local Started

            if Visible then
                if Resting < 1 then
                    Object[Property] = 1
                    Started = Library:Tween({ [Property] = Resting }, Info, Object)
                end
            elseif Object[Property] < 1 then
                Started = Library:Tween({ [Property] = 1 }, Info, Object)
            else
                Library:CancelTween(Object, Property)
            end

            if Started then
                Longest = Started
            end
        end
    end

    local function Finish()
        if ActiveFades[Target] ~= Token then
            return
        end

        if not Visible then
            Target.Visible = false

            for _, Object in next, Items do
                local Targets = Library:FadeTargets(Object)

                if not Targets then
                    continue
                end

                for _, Property in next, Targets do
                    Object[Property] = Library:GetResting(Object, Property)
                end
            end
        end

        if Callback then
            Library:SafeCall(Callback)
        end
    end

    if Longest then
        Library:Connect(Longest.Completed, Finish)
    else
        Finish()
    end

    task.delay(Info.Time + 0.08, Finish)
end

function Library:HideForBoot(Target)
    local Items = CollectFade(Target, { Target })

    for _, Object in next, Items do
        local Targets = Library:FadeTargets(Object)

        if Targets then
            for _, Property in next, Targets do
                Object[Property] = 1
            end
        end
    end
end

function Library:Hover(Enter, Leave)
    local Object = self.Instance

    if not Object or IsMobile then
        return self
    end

    Library:Connect(Object.MouseEnter, function()
        if Library.Unloaded or not Library.Toggled then
            return
        end

        Library:SafeCall(Enter)
    end)

    Library:Connect(Object.MouseLeave, function()
        Library:SafeCall(Leave)
    end)

    return self
end

function Library:HoverGradient(Field)
    if not Field or not Field.Glow then
        return self
    end

    self:Hover(function()
        Library:Tween({
            BackgroundTransparency = 0
        }, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), Field.Glow.Instance)
    end, function()
        Library:Tween({
            BackgroundTransparency = 1
        }, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), Field.Glow.Instance)
    end)

    return self
end

function Library:HoverFill(Object, Base, Hovered)
