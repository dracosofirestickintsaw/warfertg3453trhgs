        ZIndex = Library.Order.Colorpicker + 2
    }):AddToTheme({
        TextColor3 = "InactiveText"
    })

    Library:SeedResting(HexBox.Instance)

    local Popup = AttachPopup(Window, Hit, Library.Order.Colorpicker)

    Picker.Popup = Popup
    Picker.Swatch = Swatch

    local function Refresh(Silent)
        Picker.Color = Color3.fromHSV(Picker.Hue, Picker.Saturation, Picker.Value)

        Swatch.Instance.BackgroundColor3 = Picker.Color
        Palette.Instance.BackgroundColor3 = Color3.fromHSV(Picker.Hue, 1, 1)
        Alpha.Instance.BackgroundColor3 = Picker.Color
        HexBox.Instance.Text = "#" .. Picker.Color:ToHex():upper()

        Library:Tween({
            Position = UDim2.new(1 - Picker.Saturation, -5, 1 - Picker.Value, -5)
        }, KnobDrag, PaletteKnob.Instance)

        Library:Tween({
            Position = UDim2.new(0, 3, Picker.Hue, -5)
        }, KnobDrag, HueKnob.Instance)

        Library:Tween({
            Position = UDim2.new(Picker.Alpha, -5, 0, 2)
        }, KnobDrag, AlphaKnob.Instance)

        Library.Flags[Flag] = {
            Color = Picker.Color,
            HexValue = Picker.Color:ToHex(),
            Alpha = Picker.Alpha,
            Transparency = 1 - Picker.Alpha
        }

        if not Silent and Params.Callback then
            Library:SafeCall(Params.Callback, Picker.Color, Picker.Alpha)
        end
    end

    function Picker:Set(Color, NewAlpha, Silent)
        if type(Color) == "table" then
            Color = Color3.fromRGB(Color[1], Color[2], Color[3])
        elseif type(Color) == "string" then
            Color = Color3.fromHex(Color)
        end

        if typeof(Color) == "Color3" then
            Picker.Hue, Picker.Saturation, Picker.Value = Color:ToHSV()
        end

        if NewAlpha then
            Picker.Alpha = math.clamp(NewAlpha, 0, 1)
        end

        Refresh(Silent)
    end

    local function Bind(Target, Handler)
        local Sliding = false

        Target:Connect("InputBegan", function(Input)
            if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            Sliding = true
            Handler(Input)
        end)

        Library:Connect(UserInputService.InputChanged, function(Input)
            if not Sliding then
                return
            end

            if Input.UserInputType ~= Enum.UserInputType.MouseMovement and Input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            Handler(Input)
        end)

        Library:Connect(UserInputService.InputEnded, function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                Sliding = false
            end
        end)
    end

    Bind(Palette, function(Input)
        local Origin = Palette.Instance.AbsolutePosition
        local Size = Palette.Instance.AbsoluteSize

        Picker.Saturation = 1 - math.clamp((Input.Position.X - Origin.X) / math.max(1, Size.X), 0, 1)
        Picker.Value = 1 - math.clamp((Input.Position.Y - Origin.Y) / math.max(1, Size.Y), 0, 1)

        Refresh()
    end)

    Bind(Hue, function(Input)
        local Origin = Hue.Instance.AbsolutePosition
        local Size = Hue.Instance.AbsoluteSize

        Picker.Hue = math.clamp((Input.Position.Y - Origin.Y) / math.max(1, Size.Y), 0, 1)
        Refresh()
    end)

    Bind(Alpha, function(Input)
        local Origin = Alpha.Instance.AbsolutePosition
        local Size = Alpha.Instance.AbsoluteSize

        Picker.Alpha = math.clamp((Input.Position.X - Origin.X) / math.max(1, Size.X), 0, 1)
        Refresh()
    end)

    HexBox:Connect("FocusLost", function()
        local Success = pcall(function()
            Picker:Set(HexBox.Instance.Text)
        end)

        if not Success then
            Refresh(true)
        end
    end)

    Hit:Connect("MouseButton1Down", function()
        Popup:Toggle()
    end)

    Library.SetFlags[Flag] = function(Color, NewAlpha)
        Picker:Set(Color, NewAlpha)
    end

    Refresh(true)

    Element.ColorpickerObject = Picker
    return Picker
end


