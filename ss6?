    Query = Query:lower()

    if Query == "" then
        EmptyLabel.Instance.Visible = true
        EmptyLabel.Instance.Text = "Start typing to search"
        ResultScroll.Instance.CanvasSize = UDim2.fromOffset(0, 0)
        return
    end

    local Matches = {}

    for _, Item in next, Library.SearchItems do
        if Item.Name:lower():find(Query, 1, true) then
            table.insert(Matches, Item)
        end
    end

    if #Matches == 0 then
        EmptyLabel.Instance.Visible = true
        EmptyLabel.Instance.Text = "No results for \"" .. Query .. "\""
        ResultScroll.Instance.CanvasSize = UDim2.fromOffset(0, 0)
        return
