                if Debounce then return end 

                Debounce = true

                IsSidebarOpen = Bool

                Items["Side"]:FadeDescendants(Bool, function()
                    Debounce = false
                end)

                Items["Side"]:Tween({Size = UDim2.new(0, Bool and 210 or 0, 1, 0)})
            end

            Items["SidebarButton"]:Connect("MouseButton1Down", function()
                Window:SetSidebarOpen(not IsSidebarOpen)
            end)

            if IsMobile then
                Items["OpenClose"]:Connect("MouseButton1Down", function()
                    Window:SetOpen(not Window.IsOpen)
                    Items["OpenAndClose"].Instance.Text = Window.IsOpen and "Close" or "Open"
                end)
            end

